From: Segno <segno@localhost>
Subject: [PATCH] v3d: keep large BOs in the cache for minutes

Freed BOs stay in the v3d BO cache for 2 s. Flutter's Impeller renders a
full-page fade (a page transition) through an offscreen pass with 4x
MSAA, about 73 MB at 1080p on a GPU without
GL_EXT_multisampled_render_to_texture, and drops it 4 frames after the
fade. The next transition, seconds later, allocates it again, and the
kernel zeroes all of its pages at once: a burst of memory writes that
stalls the audio callback on the Pi 5 (segno #1914). BOs of 4 MB or
more now stay cached for 300 s, so a transition reuses the last one's.

Upstream-Status: Inappropriate [embedded specific]
---
--- a/src/gallium/drivers/v3d/v3d_bufmgr.c
+++ b/src/gallium/drivers/v3d/v3d_bufmgr.c
@@ -232,6 +232,9 @@
         free(bo);
 }
 
+#define V3D_BO_CACHE_LARGE (4u << 20)
+#define V3D_BO_CACHE_LARGE_SECONDS 300
+
 static void
 free_stale_bos(struct v3d_screen *screen, time_t time)
 {
@@ -240,8 +243,15 @@
 
         list_for_each_entry_safe(struct v3d_bo, bo, &cache->time_list,
                                  time_list) {
-                /* If it's more than a second old, free it. */
-                if (time - bo->free_time > 2) {
+                /* Large BOs (an offscreen render target's multisample
+                 * buffers, 73 MB at 1080p x4) are kept for minutes rather
+                 * than seconds: re-creating one makes the kernel zero all of
+                 * its pages at once, a burst that stalls the memory bus. The
+                 * list is in free order, so only a small BO young enough
+                 * ends the walk. */
+                const bool large = bo->size >= V3D_BO_CACHE_LARGE;
+                if (time - bo->free_time >
+                    (large ? V3D_BO_CACHE_LARGE_SECONDS : 2)) {
                         if (dump_stats && !freed_any) {
                                 fprintf(stderr, "Freeing stale BOs:\n");
                                 v3d_bo_dump_stats(screen);
@@ -249,7 +259,7 @@
                         }
                         v3d_bo_remove_from_cache(cache, bo);
                         v3d_bo_free(bo);
-                } else {
+                } else if (!large) {
                         break;
                 }
         }
