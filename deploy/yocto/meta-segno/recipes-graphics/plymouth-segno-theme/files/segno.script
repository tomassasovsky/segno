# Segno floor-console boot splash. The segno lockup (Bravura mark + Apple Chancery
# "segno" wordmark, pre-rendered from the smooth glyph vectors) centred on the
# console near-black (#08080A), with a determinate progress bar driven by the real
# boot progress. Static — no breathe, no shimmer, no text banners, no Pi rainbow.

Window.SetBackgroundTopColor(0.031, 0.031, 0.039);
Window.SetBackgroundBottomColor(0.031, 0.031, 0.039);
sw = Window.GetWidth();
sh = Window.GetHeight();

# --- lockup -----------------------------------------------------------------
# Scale by SCREEN HEIGHT, never native size (drawing the art unscaled once
# overflowed both displays — #803). A height fraction lands the same proportion
# on every output the console drives.
#
# The art is the MARK ALONE (940x657). The full lockup's wordmark was
# unreadable at splash size on the real panel, so it was cut rather than
# enlarged — owner's call, 2026-08-26: a boot splash reads as a mark on a dark
# field, and the product's name is on the case, not the boot screen. 0.15 keeps
# the bare mark at roughly the visual weight the lockup's mark had.
lockup.src   = Image("segno-lockup.png");
lockup.h     = Math.Int(sh * 0.15);
lockup.w     = Math.Int(lockup.h * lockup.src.GetWidth() / lockup.src.GetHeight());
lockup.image = lockup.src.Scale(lockup.w, lockup.h);
lockup.sprite = Sprite();
lockup.sprite.SetImage(lockup.image);
lockup.sprite.SetX(Math.Int((sw - lockup.w) / 2));
# Optical centre, not geometric: a mark sitting dead-centre reads as low.
lockup.sprite.SetY(Math.Int(sh * 0.42 - lockup.h / 2));
lockup.sprite.SetZ(10);
lockup.sprite.SetOpacity(1.0);

# --- progress bar (hairline track + fill) ------------------------------------
# Sits below the lockup with a clear gap rather than pinned near the bottom edge.
bar.pixel = Image("segno-bar-pixel.png");
bar.w = Math.Int(sw * 0.16);
bar.h = Math.Int(sh / 270);          # ~4px at 1080p, ~2px on the small panel
if (bar.h < 2) bar.h = 2;
bar.x = Math.Int((sw - bar.w) / 2);
bar.y = Math.Int(sh * 0.66);

bar.track = Sprite();
bar.track.SetImage(bar.pixel.Scale(bar.w, bar.h));
bar.track.SetX(bar.x);
bar.track.SetY(bar.y);
bar.track.SetOpacity(0.10);
bar.track.SetZ(8);

bar.fill = Sprite();
bar.fill.SetZ(9);
bar.progress = 0;

# The lockup is set once, above, and never touched again — the refresh callback
# only advances the fill. Nothing on this screen pulses.
fun refresh_cb() {
    fw = Math.Int(bar.w * bar.progress);
    if (fw < 2) fw = 2;
    bar.fill.SetImage(bar.pixel.Scale(fw, bar.h));
    bar.fill.SetX(bar.x);
    bar.fill.SetY(bar.y);
    bar.fill.SetOpacity(0.95);
}
Plymouth.SetRefreshFunction(refresh_cb);

fun progress_cb(duration, progress) {
    bar.progress = progress;
}
Plymouth.SetBootProgressFunction(progress_cb);

fun quit_cb() {
    lockup.sprite.SetOpacity(0);
    bar.track.SetOpacity(0);
    bar.fill.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_cb);
