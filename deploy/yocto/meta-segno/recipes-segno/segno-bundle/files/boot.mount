[Unit]
Description=Segno tryboot selector partition (/boot, holds autoboot.txt)
# The RAUC bootloader backend reads/writes /boot/autoboot.txt to select + commit
# the A/B slot, so /boot must be the tryboot selector (p1), mounted early.
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target rauc-mark-good.service
# Check and repair the FAT before mounting it, the way an fstab entry with a
# pass number would (#1397). A power cut can leave a broken cluster chain, and
# the kernel's FAT driver remounts the partition read-only when it finds one.
# That blocks RAUC's commit of a new slot. systemd-fsck runs `fsck -a`, which
# runs `fsck.vfat -a`, and its output (what it repaired) goes to the journal:
#   journalctl -b -u 'systemd-fsck@dev-disk-by\x2dlabel-tryboot.service'
# Wants, not Requires: a check that cannot repair the partition still mounts
# it. A read-only /boot is better than none, because the backend reads
# autoboot.txt to tell which slot is primary.
Wants=systemd-fsck@dev-disk-by\x2dlabel-tryboot.service
After=systemd-fsck@dev-disk-by\x2dlabel-tryboot.service

[Mount]
What=/dev/disk/by-label/tryboot
Where=/boot
Type=vfat
Options=rw,noatime

[Install]
WantedBy=local-fs.target
