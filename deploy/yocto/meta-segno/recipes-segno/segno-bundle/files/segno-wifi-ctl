#!/bin/sh
# segno-wifi-ctl — privileged WiFi helper the Flutter app drives.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status                 {supported,enabled,connected,ssid,ip,signal,
#                           saved:[{ssid,autoconnect}],last}
#   scan                   [{ssid,signal,secured}, ...]
#   connect <ssid>         {} on success (waits for activation); the key, if
#                          any, is read from stdin, never from argv. On failure
#                          exits non-zero, and when another network was active
#                          before, reactivates it and prints {"restored":<ssid>}
#   disconnect             {}
#   forget <ssid>          {}
#   radio on|off           {}
#   autoconnect <ssid> on|off
#                          {}  (connection.autoconnect of the saved profile)
#   set-password <ssid>    {}  stores a new key on the saved profile; the key
#                          is read from stdin, never from argv
#   connectivity           {"internet":true|false}: one HEAD request to the
#                          update host, 3 s limit
#
# NetworkManager owns the radio, and nothing else may. There is deliberately no
# second backend: see reclaim_wifi below for what having one cost us (#468).
set -eu

IFACE="${SEGNO_WIFI_IFACE:-wlan0}"
# The join budget. This was 20s while a wpa_supplicant fallback existed, so a
# slow AP would trip it and hand the radio away; with nothing to fall back to,
# waiting is strictly better than failing.
NM_CONNECT_WAIT_SECS="${SEGNO_WIFI_NM_CONNECT_TIMEOUT:-45}"
# Beats the ephemeral wired profile (autoconnect-priority -999). Used as the
# floor: next_autoconnect_priority lifts each new join above every saved
# network, so the one the user just picked is the one that comes back after a
# reboot (#463).
WIFI_AUTOCONNECT_PRIORITY="${SEGNO_WIFI_AUTOCONNECT_PRIORITY:-100}"
# Reaching the host the update check already contacts is the internet test, so
# the console talks to nobody new (#1270 D14). Same default as segno-update-ctl.
CONNECTIVITY_URL="${SEGNO_UPDATE_BASE:-https://segno.aquiles.dev/updates/appliance}"
CONNECTIVITY_TIMEOUT_SECS="${SEGNO_WIFI_CONNECTIVITY_TIMEOUT:-3}"
# How long a failed join waits to bring the previous network back.
RESTORE_WAIT_SECS="${SEGNO_WIFI_RESTORE_TIMEOUT:-30}"

log() { echo "segno-wifi-ctl: $*" >&2; }

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_nmcli() { command -v nmcli >/dev/null 2>&1; }
# The appliance image always ships NetworkManager, so it is the single owner
# of the radio. There used to be a wpa_supplicant fallback here for when an NM
# join failed. It was worse than the problem: taking over meant setting wlan0
# `managed no`, which made every later call pick the fallback again, so a
# console ran our supplicant and NM's dbus-owned one at the same time. Two
# supplicants on one interface tear down each other's association — the AP saw
# the console reconnect every few seconds forever. See #468.

# Undo that state if an older image (or a live-patched helper) left it behind,
# so the first run after an update repairs the console instead of inheriting a
# radio nobody owns.
reclaim_wifi() {
    have_nmcli || return 0
    # Only ever our own supplicant, matched by its config path. NM's instance
    # is `wpa_supplicant -u` and killing it would take WiFi down entirely.
    if [ -d /proc ]; then
        for pid in /proc/[0-9]*; do
            [ -r "$pid/cmdline" ] || continue
            if tr '\0' ' ' <"$pid/cmdline" 2>/dev/null \
                | grep -q "wpa_supplicant-${IFACE}.conf"; then
                log "killing a stale fallback supplicant (${pid##*/})"
                kill "${pid##*/}" 2>/dev/null || true
            fi
        done
    fi
    case "$(nmcli -t -f GENERAL.STATE device show "$IFACE" 2>/dev/null | head -n1)" in
        *unmanaged*)
            log "reclaiming $IFACE for NetworkManager"
            nmcli device set "$IFACE" managed yes >/dev/null 2>&1 || true
            ;;
    esac
}

disable_powersave() {
    command -v iw >/dev/null 2>&1 || return 0
    iw dev "$IFACE" set power_save off >/dev/null 2>&1 || true
}

iface_ip() {
    ip -4 -o addr show dev "$IFACE" 2>/dev/null \
        | awk '{print $4}' | cut -d/ -f1 | head -n1
}

iface_enabled() {
    ip -o link show "$IFACE" 2>/dev/null | grep -Eq '[,<]UP[,>]'
}

# UUID of every saved wifi profile, one per line. Listed by UUID and TYPE,
# which carry no colons, so nmcli's \:-escaping of names never reaches awk and
# a network whose name has a colon in it is still found.
wifi_profile_uuids() {
    nmcli -t -f UUID,TYPE connection show 2>/dev/null \
        | awk -F: '$2 ~ /wireless|wifi/ { print $1 }'
}

# One field of one profile, exactly as stored: -e no keeps nmcli from
# escaping colons and backslashes in it.
profile_field() {
    nmcli -e no -g "$2" connection show uuid "$1" 2>/dev/null || true
}

# Every saved wifi profile, one SSID per line. The UI needs these separately
# from a scan: a network you saved is not the same as one that happens to be
# in range, and until now the two were indistinguishable — you could not
# forget a saved network unless you were connected to it (#471).
saved_ssids() {
    wifi_profile_uuids | while IFS= read -r uuid; do
        [ -n "$uuid" ] || continue
        profile_field "$uuid" 802-11-wireless.ssid
    done
}

# One above the highest saved network, so the network the user just chose wins
# the next autoconnect. Every profile used to get the same constant, which left
# NetworkManager breaking the tie by timestamp — so a failing network the user
# had moved on from kept being reselected (#463).
next_autoconnect_priority() {
    highest=$(wifi_profile_uuids \
        | while IFS= read -r uuid; do
              [ -n "$uuid" ] || continue
              profile_field "$uuid" connection.autoconnect-priority
          done \
        | awk 'BEGIN { m = 0 } /^-?[0-9]+$/ { if ($1 > m) m = $1 } END { print m }')
    [ -n "$highest" ] || highest=0
    if [ "$highest" -lt "$WIFI_AUTOCONNECT_PRIORITY" ]; then
        printf '%s\n' "$WIFI_AUTOCONNECT_PRIORITY"
    else
        printf '%s\n' "$((highest + 1))"
    fi
}

# ---------- NetworkManager path ----------

# What wpa_supplicant said while this join was being attempted. NetworkManager
# is not a reliable narrator here, so go to the source.
JOURNALCTL="${SEGNO_JOURNALCTL:-journalctl}"
JOIN_EVIDENCE_WINDOW="${SEGNO_JOIN_EVIDENCE_WINDOW:-90}"

# iwd drives the radio, NetworkManager narrates it, and older images used
# wpa_supplicant — match all three rather than one, or a supplicant swap
# silently turns every failure back into "wrong password" (it did: this grep
# said wpa_supplicant until #470 removed it).
supplicant_evidence() {
    "$JOURNALCTL" --since "-${JOIN_EVIDENCE_WINDOW}s" --no-pager 2>/dev/null \
        | grep -aiE 'wpa_supplicant|iwd|NetworkManager' || true
}

# NetworkManager reports `Secrets were required` for two unrelated things, and
# on this console it is nearly always the wrong one.
#
# A headless appliance runs no secret agent. So when an association times out,
# NM's fallback is to ask for fresh secrets, find nobody to ask, and fail the
# connection as `no-secrets` — even when it logged "secrets exist, no new
# secrets needed" moments earlier. Believing it tells the user to re-enter a
# password that is provably correct, and hides an AP that accepted the
# association and then never started the handshake.
#
# wpa_supplicant distinguishes the two plainly, so ask it instead and only fall
# back to NM's wording when it has nothing to say.
map_connect_error() {
    err=$1
    lower=$(printf '%s' "$err" | tr '[:upper:]' '[:lower:]')
    evidence=$(supplicant_evidence)

    # A real key failure: the AP sent M1 and the MIC did not check out.
    if printf '%s' "$evidence" | grep -qiE \
        '4-way handshake failed|pre-shared key may be incorrect|reason=wrong_key'
    then
        log "authentication failed (wrong password?)"
        return 0
    fi
    # Associated, then silence. The key was never tested.
    if printf '%s' "$evidence" | grep -qiE \
        'authentication with .* timed out|association took too long'
    then
        log "timed out waiting for association"
        return 0
    fi

    # NetworkManager's own words are not evidence about the password. On a
    # headless console there is no secret agent, so ANY activation failure ends
    # as `no-secrets` — it said exactly that while holding a key that was
    # provably correct, and cost a night of debugging (#466, #459).
    #
    # Its `no-secrets` still says which dead end this was, so it is passed on
    # beside the timeout: the app, which knows whether a key was typed moments
    # ago, is the one place that can tell a fresh wrong key from a race (#829).
    if printf '%s' "$lower" | grep -qE 'wrong[^[:space:]]*password|invalid passphrase'
    then
        log "authentication failed (wrong password?)"
    elif printf '%s' "$lower" | grep -qE 'secrets were required|no secrets'
    then
        log "timed out waiting for association (secrets were required)"
    elif printf '%s' "$lower" | grep -qE '802\.1x|took too long|timeout'
    then
        log "timed out waiting for association"
    else
        log "connection failed: $err"
    fi
}

# Every saved wifi profile as `"saved":[{ssid,autoconnect}],"last":<ssid>`,
# the tail of the status object. `last` is the profile NetworkManager activated
# most recently, which is the network a dropped console was on: the app shows
# "Connection lost" for it while the radio is on and nothing is associated.
#
# Listed by UUID and TIMESTAMP, which carry no colons, so nmcli's \:-escaping
# of names never reaches awk (the same reading as segno-wifi-retry). The SSID
# comes from each profile itself rather than from its name.
saved_status_json() {
    listing=$(nmcli -t -f UUID,TYPE,AUTOCONNECT,TIMESTAMP connection show 2>/dev/null \
        | awk -F: '$2 ~ /wireless/ { print $4 "\t" $1 "\t" $3 }' | sort -rn)
    first=1
    last=
    printf '"saved":['
    while IFS="$(printf '\t')" read -r stamp uuid auto; do
        [ -n "$uuid" ] || continue
        ssid=$(profile_field "$uuid" 802-11-wireless.ssid)
        [ -n "$ssid" ] || continue
        if [ -z "$last" ] && [ "${stamp:-0}" -gt 0 ] 2>/dev/null; then
            last=$ssid
        fi
        autoconnect=true
        case "$auto" in no|false) autoconnect=false ;; esac
        if [ "$first" -eq 1 ]; then first=0; else printf ','; fi
        printf '{"ssid":"%s","autoconnect":%s}' "$(json_escape "$ssid")" "$autoconnect"
    done <<EOF
$listing
EOF
    printf '],"last":"%s"' "$(json_escape "$last")"
}

do_status_nm() {
    wifi_radio=$(nmcli -t -f WIFI radio 2>/dev/null || echo disabled)
    enabled=false
    case "$wifi_radio" in enabled|on) enabled=true ;; esac

    if [ "$enabled" != true ]; then
        printf '{"supported":true,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0,%s}\n' \
            "$(saved_status_json)"
        return 0
    fi

    state=$(nmcli -t -f GENERAL.STATE device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.STATE://p' | head -n1)
    connected=false
    case "$state" in 100\ *|*\(connected\)*) connected=true ;; esac

    ssid=$(nmcli -t -f GENERAL.CONNECTION device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.CONNECTION://p' | head -n1)
    case "$ssid" in ''|--*) ssid= ;; esac

    ip=$(nmcli -t -f IP4.ADDRESS device show "$IFACE" 2>/dev/null \
        | sed -n 's/^IP4.ADDRESS\[[0-9]*\]://p' | head -n1 | cut -d/ -f1)

    signal=0
    if [ "$connected" = true ] && [ -n "$ssid" ]; then
        signal=$(nmcli -t -f IN-USE,SIGNAL device wifi list ifname "$IFACE" 2>/dev/null \
            | awk -F: '$1=="*" {print $2; exit}')
        [ -n "$signal" ] || signal=0
    fi

    printf '{"supported":true,"enabled":true,"connected":%s,"ssid":"%s","ip":"%s","signal":%s,%s}\n' \
        "$connected" "$(json_escape "${ssid:-}")" "$(json_escape "${ip:-}")" "$signal" \
        "$(saved_status_json)"
}

do_radio_nm() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "radio needs on|off"; return 2 ;; esac
    nmcli radio wifi "$onoff" >/dev/null
    echo '{}'
}

do_scan_nm() {
    nmcli radio wifi on >/dev/null 2>&1 || true
    nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
    sleep 2

    raw=$(mktemp)
    ranked=$(mktemp)
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list ifname "$IFACE" 2>/dev/null >"$raw" || true

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        security=${line##*:}
        rest=${line%:*}
        signal=${rest##*:}
        # Terse output escapes ':' and '\\' in the name; the rest are numbers
        # and words, so the name is everything before them, unescaped.
        ssid=$(printf '%s' "${rest%:*}" | sed 's/\\\(.\)/\1/g')
        [ -n "$ssid" ] || continue
        case "$ssid" in --*) continue ;; esac
        secured=true
        case "$security" in ''|--*) secured=false ;; esac
        ssid_safe=$(printf '%s' "$ssid" | tr '\t' ' ')
        printf '%s\t%s\t%s\n' "$ssid_safe" "${signal:-0}" "$secured"
    done <"$raw" | awk -F'\t' '
        {
            ssid=$1; sig=$2+0; sec=$3
            if (!(ssid in best) || sig > best[ssid]) {
                best[ssid]=sig
                secured[ssid]=sec
            }
        }
        END {
            for (s in best) printf "%s\t%d\t%s\n", s, best[s], secured[s]
        }
    ' | sort -t"$(printf '\t')" -k2,2nr >"$ranked"

    # A saved network that is out of range still belongs in the list. Otherwise
    # the only way to forget one is to be connected to it, which is impossible
    # precisely when the saved profile is the thing that will not connect
    # (#471). inRange says whether the scan actually saw it — carried
    # explicitly because signal is dBm on some paths and 0-100 quality on
    # others, so no sentinel value is safe.
    saved=$(mktemp)
    saved_ssids >"$saved"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        if ! cut -f1 "$ranked" | grep -qxF "$name"; then
            printf '%s\t0\ttrue\tfalse\n' "$name" >>"$ranked"
        fi
    done <"$saved"

    first=1
    printf '['
    while IFS="$(printf '\t')" read -r ssid signal secured in_range; do
        [ -n "$ssid" ] || continue
        [ -n "$in_range" ] || in_range=true
        is_saved=false
        grep -qxF "$ssid" "$saved" && is_saved=true
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '{"ssid":"%s","signal":%s,"secured":%s,"saved":%s,"inRange":%s}' \
            "$(json_escape "$ssid")" "$signal" "$secured" "$is_saved" "$in_range"
    done <"$ranked"
    printf ']\n'
    rm -f "$raw" "$ranked" "$saved"
}

# UUIDs of every saved wifi profile for this SSID, matched by connection name
# or 802-11-wireless.ssid. Both are read one profile at a time, unescaped, so
# a name with a colon in it matches.
profile_uuids_for_ssid() {
    ssid=$1
    wifi_profile_uuids | while IFS= read -r uuid; do
        [ -n "$uuid" ] || continue
        if [ "$(profile_field "$uuid" connection.id)" = "$ssid" ] \
            || [ "$(profile_field "$uuid" 802-11-wireless.ssid)" = "$ssid" ]
        then
            printf '%s\n' "$uuid"
        fi
    done
}

profile_uuid_for_ssid() { profile_uuids_for_ssid "$1" | head -n1; }

do_forget_nm() {
    profile_uuids_for_ssid "$1" | while IFS= read -r uuid; do
        nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
    done
    echo '{}'
}

# A UUID for a profile this helper creates, so it is activated and, on
# failure, deleted by that UUID — never by a name another profile may share.
new_uuid() {
    { cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen; } \
        | tr '[:upper:]' '[:lower:]'
}

# The key as one passwd-file line. nmcli reads that file with backslash
# escapes and strips unescaped spaces at either end, so every backslash and
# space is escaped and the key arrives byte for byte. Builtins and stdin only:
# the key is never in any argv.
write_passwd_file() {
    printf '802-11-wireless-security.psk:' >"$1"
    printf '%s' "$2" | sed 's/\\/\\\\/g; s/ /\\ /g' >>"$1"
    printf '\n' >>"$1"
}

# Stores the key on a saved profile through nmcli's editor, fed on stdin: an
# argument would be readable by every process on the console through
# /proc/<pid>/cmdline. The editor strips spaces at either end of a value, so a
# key that starts or ends with one cannot be stored this way and is refused.
store_psk() {
    case "$2" in
        ' '*|*' ')
            log "a password that starts or ends with a space can only be set by joining"
            return 2
            ;;
    esac
    printf 'set 802-11-wireless-security.psk %s\nset 802-11-wireless-security.psk-flags 0\nsave persistent\nquit\n' \
        "$2" | nmcli connection edit uuid "$1" >/dev/null 2>&1
}

# After a successful passwd-file up: make sure the PSK is in the keyfile and
# only then allow NM to auto-activate. Shared by new-join and
# reuse-with-password so the two cannot drift on when autoconnect turns on
# (#963). NetworkManager saves a system-owned key an agent (nmcli, reading the
# passwd-file) hands it, byte for byte; it is written again only when the
# stored one is not the key that just worked. Never in any argv.
persist_psk_and_enable() {
    uuid=$1
    psk_val=$2
    if [ "$(nmcli -s -e no -g 802-11-wireless-security.psk connection show uuid "$uuid" 2>/dev/null || true)" != "$psk_val" ]; then
        store_psk "$uuid" "$psk_val" || log "could not store the password"
    fi
    nmcli connection modify uuid "$uuid" \
        wifi-sec.psk-flags 0 \
        connection.autoconnect yes \
        >/dev/null 2>&1 || true
}

# UUID of the wifi connection active on $IFACE right now, or empty. UUIDs carry
# no colons, so the terse listing splits cleanly.
active_wifi_uuid() {
    nmcli -t -f UUID,TYPE,DEVICE connection show --active 2>/dev/null \
        | awk -F: -v dev="$IFACE" '$2 ~ /wireless/ && $3 == dev { print $1; exit }'
}

# One radio cannot hold the old link while it joins a new one: activating a
# second profile on wlan0 drops the first. So a join that fails brings back
# whatever was active before it started, and says so (#1270 D13). Best effort:
# if the old network is gone too, there is nothing better to fall back to.
restore_previous() {
    prev=$1
    [ -n "$prev" ] || return 0
    [ "$prev" != "$(active_wifi_uuid)" ] || return 0
    if nmcli --wait "$RESTORE_WAIT_SECS" connection up uuid "$prev" >/dev/null 2>&1; then
        name=$(profile_field "$prev" 802-11-wireless.ssid)
        log "join failed; reconnected to ${name:-$prev}"
        printf '{"restored":"%s"}\n' "$(json_escape "${name:-}")"
    else
        log "join failed; the previous network did not come back"
    fi
}

do_connect_nm() {
    ssid=$1
    # The key comes on stdin: an argument would be readable by every process
    # on the console through /proc/<pid>/cmdline. Empty for an open network
    # or a saved one joined on its stored key.
    psk=
    if [ ! -t 0 ]; then
        IFS= read -r psk || true
    fi
    nmcli radio wifi on >/dev/null 2>&1 || true
    disable_powersave

    # Rejoining the network that is up (a new password for it) falls back to
    # that same network: its old key stays stored until the new one works.
    previous=$(active_wifi_uuid)
    existing=$(profile_uuid_for_ssid "$ssid")
    prior_autoconnect=yes
    if [ -n "$existing" ]; then
        case "$(nmcli -g connection.autoconnect connection show uuid "$existing" 2>/dev/null)" in
            no) prior_autoconnect=no ;;
        esac
    fi
    join_priority=$(next_autoconnect_priority)
    errf=$(mktemp)
    passf=
    created=
    set +e
    if [ -n "$existing" ]; then
        # Reuse the saved profile. Deleting it to "reconnect" is how Join on a
        # saved network threw the PSK away and then failed (#963).
        # A password update (or a leftover secret-less husk) must not flip
        # autoconnect on before the PSK is stored — same NM/iwd abort race as
        # a new join. A promptless Join already holds secrets; autoconnect
        # stays on.
        if [ -n "$psk" ]; then
            ac=no
        else
            ac=yes
        fi
        nmcli connection modify uuid "$existing" \
            connection.autoconnect "$ac" \
            connection.autoconnect-priority "$join_priority" \
            802-11-wireless.powersave 2 \
            >"$errf" 2>&1
        rc=$?
        if [ "$rc" -eq 0 ] && [ -n "$psk" ]; then
            passf=$(mktemp)
            chmod 600 "$passf"
            write_passwd_file "$passf" "$psk"
            nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up uuid "$existing" \
                passwd-file "$passf" >"$errf" 2>&1
            rc=$?
            if [ "$rc" -eq 0 ]; then
                persist_psk_and_enable "$existing" "$psk"
            fi
        elif [ "$rc" -eq 0 ]; then
            nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up uuid "$existing" \
                >"$errf" 2>&1
            rc=$?
        fi
    elif [ -n "$psk" ]; then
        # New secured network. autoconnect stays off until the PSK is stored —
        # otherwise NM auto-activates a secret-less profile, aborts iwd, and
        # races the real up (#963).
        # Create the profile without embedding the PSK in argv, then activate
        # via passwd-file. On this image `connection up` after `wifi-sec.psk=…`
        # often fails immediately with "Secrets were required".
        created=$(new_uuid)
        nmcli connection add type wifi ifname "$IFACE" con-name "$ssid" \
            connection.uuid "$created" \
            ssid "$ssid" \
            wifi-sec.key-mgmt wpa-psk \
            wifi-sec.auth-alg open \
            connection.autoconnect no \
            connection.autoconnect-priority "$join_priority" \
            802-11-wireless.powersave 2 \
            >"$errf" 2>&1
        rc=$?
        if [ "$rc" -eq 0 ]; then
            passf=$(mktemp)
            chmod 600 "$passf"
            write_passwd_file "$passf" "$psk"
            nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up uuid "$created" \
                passwd-file "$passf" >"$errf" 2>&1
            rc=$?
            if [ "$rc" -eq 0 ]; then
                persist_psk_and_enable "$created" "$psk"
            fi
        fi
    else
        created=$(new_uuid)
        nmcli connection add type wifi ifname "$IFACE" con-name "$ssid" \
            connection.uuid "$created" \
            ssid "$ssid" \
            connection.autoconnect yes \
            connection.autoconnect-priority "$join_priority" \
            802-11-wireless.powersave 2 \
            >"$errf" 2>&1 \
            && nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up uuid "$created" \
                >"$errf" 2>&1
        rc=$?
    fi
    set -e
    rm -f "$passf"
    if [ "$rc" -ne 0 ]; then
        map_connect_error "$(cat "$errf")"
        rm -f "$errf"
        # A failed attempt leaves nothing behind: a profile made for it is
        # removed, so the list never shows the network as saved with a key
        # that did not work, and a saved one keeps its own autoconnect.
        if [ -n "$created" ]; then
            nmcli connection delete uuid "$created" >/dev/null 2>&1 || true
        elif [ -n "$existing" ] && [ -n "$psk" ]; then
            nmcli connection modify uuid "$existing" \
                connection.autoconnect "$prior_autoconnect" >/dev/null 2>&1 || true
        fi
        restore_previous "$previous"
        return 1
    fi
    rm -f "$errf"
    echo '{}'
}

do_disconnect_nm() {
    nmcli device disconnect "$IFACE" >/dev/null 2>&1 || true
    echo '{}'
}

do_autoconnect_nm() {
    ssid=$1
    case "$2" in
        on) value=yes ;;
        off) value=no ;;
        *) log "autoconnect needs on|off"; return 2 ;;
    esac
    uuid=$(profile_uuid_for_ssid "$ssid")
    if [ -z "$uuid" ]; then
        log "no saved network named $ssid"
        return 1
    fi
    nmcli connection modify uuid "$uuid" connection.autoconnect "$value" >/dev/null
    echo '{}'
}

# The key arrives on stdin and reaches NetworkManager on nmcli's stdin, through
# its interactive editor (store_psk). Stored only; the network is not
# activated, so changing the key of a network that is out of range works.
do_set_password_nm() {
    ssid=$1
    psk=
    IFS= read -r psk || [ -n "$psk" ] || true
    if [ -z "$psk" ]; then
        log "set-password needs the key on stdin"
        return 2
    fi
    uuid=$(profile_uuid_for_ssid "$ssid")
    if [ -z "$uuid" ]; then
        log "no saved network named $ssid"
        return 1
    fi
    store_psk "$uuid" "$psk" || {
        rc=$?
        [ "$rc" -eq 2 ] && return 2
        log "could not store the new password"
        return 1
    }
    echo '{}'
}

# Whether the internet is reachable, asked only while the Network page is open
# (#1270 D14): one HEAD request to the update host, over Wi-Fi itself so a
# wired link cannot answer for it. Any HTTP answer, error statuses included,
# proves the path; only no answer at all means no internet.
do_connectivity() {
    if ! command -v curl >/dev/null 2>&1; then
        log "curl is not installed"
        return 1
    fi
    code=$(curl -sS -I -o /dev/null -w '%{http_code}' \
        --interface "$IFACE" --max-time "$CONNECTIVITY_TIMEOUT_SECS" "$CONNECTIVITY_URL" 2>/dev/null) || true
    case "$code" in
        ''|000) echo '{"internet":false}' ;;
        *) echo '{"internet":true}' ;;
    esac
}

# Every verb repairs the ownership state first: it is idempotent, costs one
# nmcli read, and means a console does not stay broken until someone reboots it.
require_nm() {
    if ! have_nmcli; then
        log "NetworkManager (nmcli) is not installed"
        return 1
    fi
    reclaim_wifi
}

do_status() {
    if ! have_nmcli; then
        echo '{"supported":false,"enabled":false,"connected":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    reclaim_wifi
    do_status_nm
}

do_radio() { require_nm && do_radio_nm "$@"; }
do_scan() { require_nm || { echo '[]'; return 1; }; do_scan_nm; }
do_connect() { require_nm && do_connect_nm "$@"; }
do_disconnect() { require_nm && do_disconnect_nm; }
do_forget() { require_nm && do_forget_nm "$@"; }
do_autoconnect() { require_nm && do_autoconnect_nm "$@"; }
do_set_password() { require_nm && do_set_password_nm "$@"; }

usage() {
    log "usage: $0 status|scan|connect <ssid>|disconnect|forget <ssid>|radio on|off|autoconnect <ssid> on|off|set-password <ssid>|connectivity"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    scan) do_scan ;;
    connect)
        # Exactly the SSID: a key in argv would be readable by every process
        # on the console, so one is refused rather than ignored.
        [ $# -eq 1 ] || usage
        do_connect "$@"
        ;;
    disconnect) do_disconnect ;;
    forget)
        [ $# -ge 1 ] || usage
        do_forget "$1"
        ;;
    radio)
        [ $# -ge 1 ] || usage
        do_radio "$1"
        ;;
    autoconnect)
        [ $# -ge 2 ] || usage
        do_autoconnect "$1" "$2"
        ;;
    set-password)
        [ $# -ge 1 ] || usage
        do_set_password "$1"
        ;;
    connectivity) do_connectivity ;;
    *) usage ;;
esac
