#!/bin/sh
# segno-wifi-ctl — privileged WiFi helper the Flutter app drives.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status                 {supported,enabled,connected,connecting,ssid,ip,
#                           signal,saved:[{ssid,autoconnect}],last}
#   scan                   [{ssid,signal,secured,saved,inRange}, ...]
#   connect <ssid>         {} on success (waits for activation); the key, if
#                          any, is read from stdin, never from argv. On failure
#                          exits non-zero and prints {"error":<code>} (see
#                          join_failure); when another network was active
#                          before, it reactivates it and also prints
#                          {"restored":<ssid>}
#   monitor                {"event":<text>} per NetworkManager change, until
#                          killed (do_monitor_nm)
#   disconnect             {}
#   forget <ssid>          {}
#   radio on|off           {}
#   autoconnect <ssid> on|off
#                          {}  (connection.autoconnect of the saved profile)
#   set-password <ssid>    {}  stores a new key on the saved profile; the key
#                          is read from stdin, never from argv
#   connectivity           {"internet":true|false}: one HEAD request to the
#                          update host, 3 s limit
#   activate <uuid> [secs] {} once the saved profile is up on its stored key
#                          (up_saved); used by segno-wifi-retry
#
# NetworkManager owns the radio, and nothing else may: it runs wpa_supplicant
# itself, as on Raspberry Pi OS (#1843). There is deliberately no second
# backend. One used to exist here, and taking the radio over for it left a
# console with two supplicants on wlan0 tearing down each other's
# association (#468).
set -eu

# A passwd-file holds a key in the clear, so it must not outlive the helper,
# even when it is stopped mid-join; a saved profile hold_profile set aside
# for a new key goes back to what is stored; and the device autoconnect
# up_with_key paused for an activation comes back. An untrapped TERM skips
# the EXIT trap in dash, so the signals exit through it.
passf=
up_keyf=
paused_iface=
held_uuid=
held_file=
trap 'rm -f "$passf" "$up_keyf"; release_profile; resume_autoconnect' EXIT
trap 'exit 1' HUP INT TERM

IFACE="${SEGNO_WIFI_IFACE:-wlan0}"
# The join budget. With nothing to fall back to, waiting is better than
# failing early.
NM_CONNECT_WAIT_SECS="${SEGNO_WIFI_NM_CONNECT_TIMEOUT:-45}"
# Beats the ephemeral wired profile (autoconnect-priority -999). Used as the
# floor: next_autoconnect_priority lifts each new join above every saved
# network, so the one the user just picked is the one that comes back after a
# reboot (#463).
WIFI_AUTOCONNECT_PRIORITY="${SEGNO_WIFI_AUTOCONNECT_PRIORITY:-100}"
# Reaching the host the update check already contacts is the internet test, so
# the console talks to nobody new (#1270 D14). Same default as segno-update-ctl.
CONNECTIVITY_URL="${SEGNO_UPDATE_BASE:-https://segno.aquiles.dev/updates/appliance}"
CONNECTIVITY_TIMEOUT_SECS="${SEGNO_WIFI_CONNECTIVITY_TIMEOUT:-3}"
# How long a failed join waits to bring the previous network back.
RESTORE_WAIT_SECS="${SEGNO_WIFI_RESTORE_TIMEOUT:-30}"
# Where NetworkManager keeps the profiles it holds in memory only.
NM_RUN_DIR="${SEGNO_NM_RUN_DIR:-/run/NetworkManager}"

log() { echo "segno-wifi-ctl: $*" >&2; }

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

have_nmcli() { command -v nmcli >/dev/null 2>&1; }

iface_ip() {
    ip -4 -o addr show dev "$IFACE" 2>/dev/null \
        | awk '{print $4}' | cut -d/ -f1 | head -n1
}

iface_enabled() {
    ip -o link show "$IFACE" 2>/dev/null | grep -Eq '[,<]UP[,>]'
}

# UUID of every saved wifi profile, one per line. Listed by UUID and TYPE,
# which carry no colons, so nmcli's \:-escaping of names never reaches awk and
# a network whose name has a colon in it is still found.
wifi_profile_uuids() {
    nmcli -t -f UUID,TYPE connection show 2>/dev/null \
        | awk -F: '$2 ~ /wireless|wifi/ { print $1 }'
}

# One field of one profile, exactly as stored: -e no keeps nmcli from
# escaping colons and backslashes in it.
profile_field() {
    nmcli -e no -g "$2" connection show uuid "$1" 2>/dev/null || true
}

# Every saved wifi profile, one SSID per line. The UI needs these separately
# from a scan: a network you saved is not the same as one that happens to be
# in range, and until now the two were indistinguishable — you could not
# forget a saved network unless you were connected to it (#471).
saved_ssids() {
    wifi_profile_uuids | while IFS= read -r uuid; do
        [ -n "$uuid" ] || continue
        profile_field "$uuid" 802-11-wireless.ssid
    done
}

# One above the highest saved network, so the network the user just chose wins
# the next autoconnect. Every profile used to get the same constant, which left
# NetworkManager breaking the tie by timestamp — so a failing network the user
# had moved on from kept being reselected (#463).
next_autoconnect_priority() {
    highest=$(wifi_profile_uuids \
        | while IFS= read -r uuid; do
              [ -n "$uuid" ] || continue
              profile_field "$uuid" connection.autoconnect-priority
          done \
        | awk 'BEGIN { m = 0 } /^-?[0-9]+$/ { if ($1 > m) m = $1 } END { print m }')
    [ -n "$highest" ] || highest=0
    if [ "$highest" -lt "$WIFI_AUTOCONNECT_PRIORITY" ]; then
        printf '%s\n' "$WIFI_AUTOCONNECT_PRIORITY"
    else
        printf '%s\n' "$((highest + 1))"
    fi
}

# ---------- NetworkManager path ----------

JOURNALCTL="${SEGNO_JOURNALCTL:-journalctl}"
# How long join_failure waits, at most, for wpa_supplicant's lines when the
# journal has none of them yet: journald stores a line a moment after
# wpa_supplicant writes it, and a wrong key whose line comes late must not
# read as no-connection. Read again once a second; only a failure
# wpa_supplicant never logs pays the whole wait.
JOIN_EVIDENCE_WAIT_SECS="${SEGNO_JOIN_EVIDENCE_WAIT:-3}"
# How often up_with_key reads the journal while a join runs, in seconds.
JOIN_WATCH_INTERVAL="${SEGNO_JOIN_WATCH_INTERVAL:-1}"

# The journal's position now: the cursor of its last entry, or empty.
join_mark() {
    "$JOURNALCTL" -n 0 --show-cursor --no-pager 2>/dev/null \
        | sed -n 's/^-- cursor: //p'
}

# What wpa_supplicant and NetworkManager logged after <cursor>, the start of
# this join, or since <epoch> when the journal gave no cursor: never an
# earlier attempt's lines, which once made a failed join of an open network
# read as a wrong password (#1817). A cursor rather than the second the join
# began, which can hold the end of the attempt before it. wpa_supplicant logs
# to syslog (`-s` in its unit, as on Pi OS), so its lines carry the
# wpa_supplicant identifier.
join_evidence() {
    if [ -n "$1" ]; then
        "$JOURNALCTL" --after-cursor "$1" --no-pager -o cat -t wpa_supplicant -t NetworkManager \
            2>/dev/null || true
    else
        "$JOURNALCTL" --since "@$2" --no-pager -o cat -t wpa_supplicant -t NetworkManager \
            2>/dev/null || true
    fi
}

# wpa_supplicant's lines alone since <cursor> (or <epoch>): what the watch in
# up_with_key reads once a second while a join runs.
wpa_evidence() {
    if [ -n "$1" ]; then
        "$JOURNALCTL" --after-cursor "$1" --no-pager -o cat -t wpa_supplicant 2>/dev/null || true
    else
        "$JOURNALCTL" --since "@$2" --no-pager -o cat -t wpa_supplicant 2>/dev/null || true
    fi
}

# The access point's refusals of the key in <evidence>, one
# "<disconnect line> / <handshake line>" each: a disconnect the access point
# sent (no locally_generated=1) followed by wpa_supplicant's "4-Way Handshake
# failed". wpa_supplicant writes the disconnect, then the handshake line, for
# the same event. Android counts the same thing as a wrong password
# (SupplicantStaIfaceCallbackImpl.onDisconnected: a disconnect during the
# 4-way handshake that was not locally generated).
key_refusals() {
    printf '%s\n' "$1" | awk '
        /CTRL-EVENT-DISCONNECTED/ { d = $0; next }
        /4-Way Handshake failed/ {
            if (d != "" && d !~ /locally_generated=1/) print d " / " $0
            d = ""
        }'
}

# Whether <evidence> proves the key wrong, printing the refusal that does.
# One refusal is enough when its reason names the key: 15 (4-way handshake
# timeout, what most access points send when the station's message 2 fails
# its check), 14 (MIC failure) or 23 (802.1X authentication failed). Other
# access points send another reason: an ASUS RT-AX89X sends 2, "previous
# authentication no longer valid" (#1859). Two refusals in one join are
# enough whatever the reason, while one is not: a router that restarts
# mid-handshake drops the station once, with a reason of its own, and that
# once read as a wrong password (#1817). A wrong key is refused on every try,
# about every 3 s.
#
# A join whose handshake completed (CTRL-EVENT-CONNECTED) proves the key
# right, so refusals before or after it in the same join prove nothing: on
# 2026-11-18 the RT-AX89X refused the right key once and accepted it 0.2 s
# later, and the watch took that connection down (#1816).
key_wrong() {
    if printf '%s\n' "$1" | grep -qa 'CTRL-EVENT-CONNECTED'; then
        return 1
    fi
    kw_refusals=$(key_refusals "$1")
    [ -n "$kw_refusals" ] || return 1
    kw_line=$(printf '%s\n' "$kw_refusals" | grep -E ' reason=(14|15|23)( |/)' | head -n1)
    if [ -z "$kw_line" ] && [ "$(printf '%s\n' "$kw_refusals" | wc -l)" -ge 2 ]; then
        kw_line=$(printf '%s\n' "$kw_refusals" | tail -n1)
    fi
    [ -n "$kw_line" ] || return 1
    printf '%s\n' "$kw_line"
}

# The wpa_supplicant 2.11 lines that end an attempt, as an ERE. One in the
# journal means the journal holds at least part of the attempt:
#
#   WPA: 4-Way Handshake failed - pre-shared key may be incorrect
#       events.c, wpa_supplicant_event_disassoc_finish: the link dropped
#       during the initial 4-way handshake of a PSK network. The access point
#       sent message 1, so it had the station's association, and then did not
#       accept the key. It is followed by CTRL-EVENT-SSID-TEMP-DISABLED with
#       reason=WRONG_KEY.
#   CTRL-EVENT-ASSOC-REJECT ... status_code=<n>
#       the access point refused the 802.11 authentication or association,
#       or let it time out (status 16, #1816).
#   CTRL-EVENT-AUTH-REJECT ... status_code=<n>
#       the same refusal, from wpa_supplicant's own authentication (SME).
#   Authentication with <bssid> timed out.
#       wpa_supplicant.c, wpa_supplicant_timeout: associated, but the 4-way
#       handshake never started, because the access point never sent
#       message 1 (#470). The key was not tested.
#   CTRL-EVENT-SSID-TEMP-DISABLED ... reason=<why>
#       wpa_supplicant set the network aside after a failure.
WPA_END_RE='4-Way Handshake failed|CTRL-EVENT-ASSOC-REJECT|CTRL-EVENT-AUTH-REJECT|Authentication with [0-9a-f:]+ timed out|CTRL-EVENT-SSID-TEMP-DISABLED'

# Why a join failed, as one code on stdout ({"error":<code>}) for the app to
# word, with the evidence on stderr:
#
#   wrong-password  the access point refused the key (key_wrong): it ended
#                   the handshake once with a reason that means the key, or
#                   twice with any reason, and only for a key that has
#                   not connected on this profile (<judge> is yes,
#                   key_proven). wpa_supplicant logs the handshake
#                   line for any drop during the handshake (events.c,
#                   could_be_psk_mismatch), so its own timeout
#                   (locally_generated=1) and a single drop with another
#                   reason, a router restarting mid-join, do not count.
#   not-found       the network is not in range: NetworkManager's
#                   `ssid-not-found` ("The Wi-Fi network could not be
#                   found").
#   no-address      the link came up but no IPv4 address did:
#                   `ip-config-unavailable` ("IP configuration could not be
#                   reserved"), DHCP.
#   no-connection   everything else, the key never tested: the access point
#                   rejected or timed out the authentication or association
#                   (CTRL-EVENT-ASSOC-REJECT status_code=16, #1816), never
#                   started the handshake ("Authentication with ... timed
#                   out.", #470), or the join ran out of time.
#
# NetworkManager's own reason is not evidence about the key. A join that
# times out before the handshake makes it ask a secret agent for a new key
# whenever the profile has not connected before (nm-device-wifi.c,
# supplicant_connection_timeout_cb), and so does any drop during the
# handshake (handle_8021x_or_psk_auth_fail). A headless console has no agent,
# so all of these end as `no-secrets` ("Secrets were required, but not
# provided"), and reading that as a wrong password made the owner forget good
# networks (#466, #1817).
# <err> is nmcli's output, <cursor> and <epoch> mark the attempt's start,
# <uuid> and <ssid> name the profile it activated, and <judge> (yes unless
# given) says whether a refusal may be read as a wrong key.
join_failure() {
    err=$1
    lower=$(printf '%s' "$err" | tr '[:upper:]' '[:lower:]')
    evidence=$(join_evidence "$2" "$3")
    # Read until the handshake failure is there, or until a line that ended
    # an attempt was there on the read before as well. One join can hold
    # several attempts (an access point that rejects one association and
    # accepts the next, then refuses the key), and journald may store the
    # handshake line a moment after the rejection that came before it, so a
    # single end line is not enough to stop on: a wrong key must not read as
    # no-connection. Read once a second, for at most the wait.
    waited=0
    ended=no
    while ! printf '%s' "$evidence" | grep -qa '4-Way Handshake failed' \
        && [ "$waited" -lt "$JOIN_EVIDENCE_WAIT_SECS" ]; do
        if printf '%s' "$evidence" | grep -qaE "$WPA_END_RE"; then
            [ "$ended" = no ] || break
            ended=yes
        fi
        sleep 1
        waited=$((waited + 1))
        evidence=$(join_evidence "$2" "$3")
    done
    # The refusal that proves the key wrong, as "<disconnect line> /
    # <handshake line>", or nothing.
    refused=
    if [ "${6:-yes}" = yes ]; then
        refused=$(key_wrong "$evidence") || refused=
    fi
    # NetworkManager's lines about this join only: from the activation of
    # this profile on, and about this interface. Another device's failure
    # (eth0 with no DHCP server), or NM's own attempt at another profile on
    # wlan0 just before (a hidden network out of range), says nothing
    # about it.
    nm_wifi=$(printf '%s\n' "$evidence" | awk -v uuid="($4)" -v name="connection '$5' (" -v dev="device ($IFACE):" '
        index($0, "Activation: starting connection") && ((uuid != "()" && index($0, uuid)) || index($0, name)) { buf = ""; on = 1 }
        on && index($0, dev) { buf = buf $0 "\n" }
        END { printf "%s", buf }')
    # The line that says most, for the journal: the refused key if it was,
    # else the last line that ended an attempt.
    wpa_said=$refused
    [ -n "$wpa_said" ] \
        || wpa_said=$(printf '%s\n' "$evidence" | grep -aE "$WPA_END_RE" | tail -n1)
    if [ -n "$refused" ]; then
        code=wrong-password
    elif printf '%s' "$lower" | grep -qE 'could not be found|no network with ssid' \
        || printf '%s' "$nm_wifi" | grep -qa "reason 'ssid-not-found'"; then
        code=not-found
    elif printf '%s' "$lower" | grep -qE 'ip configuration could not be reserved|dhcp' \
        || printf '%s' "$nm_wifi" | grep -qa "reason 'ip-config-unavailable'"; then
        code=no-address
    else
        code=no-connection
    fi
    log "join failed: $code (${wpa_said:-no wpa_supplicant evidence}; nmcli: $err)"
    printf '{"error":"%s"}\n' "$code"
}

# Whether the key a join uses has already connected on saved profile <uuid>:
# the profile has connected (NetworkManager's connection.timestamp, set on
# each successful activation, is not 0) and the join uses its stored key,
# either because no key was typed (<typed> empty) or because the typed one is
# the stored one. Android trusts a refused handshake as a wrong password
# only for a network that has never connected
# (NetworkSelectionStatus.hasEverConnected, reset when the key changes); on
# one that has, it counts a temporary authentication failure and retries.
# A proven key refused is the access point's fault, not the key's: after a
# radio restart the owner's RT-AX89X refused the right key with reason 2 for
# 44 minutes (#1816). NetworkManager keeps the timestamp when set-password
# stores a new key and nmcli cannot reset it, so a key stored that way for a
# network that has connected before reads as proven until it connects.
key_proven() {
    case "$(profile_field "$1" connection.timestamp)" in
        ''|0|*[!0-9]*) return 1 ;;
    esac
    [ -n "$2" ] || return 0
    [ "$(nmcli -s -e no -g 802-11-wireless-security.psk connection show uuid "$1" 2>/dev/null || true)" = "$2" ]
}

# Whether <ssid> is missing from what the radio can see: NetworkManager's list
# from the last scan, then a fresh scan when that list lacks it. Missing only
# when a list came back without it; an empty list proves nothing (the radio
# just came on, or the scan failed), and the join then goes ahead. Checked
# before anything changes, so a join that cannot work never drops the network
# that is up.
ssid_missing() {
    seen=
    for rescan in no yes; do
        seen=$(nmcli -t -e no -f SSID device wifi list ifname "$IFACE" \
            --rescan "$rescan" 2>/dev/null) || seen=
        [ -n "$seen" ] || continue
        if printf '%s\n' "$seen" | grep -qxF -- "$1"; then
            return 1
        fi
    done
    [ -n "$seen" ]
}

# Every saved wifi profile as `"saved":[{ssid,autoconnect}],"last":<ssid>`,
# the tail of the status object. `last` is the profile NetworkManager activated
# most recently, which is the network a dropped console was on: the app shows
# "Connection lost" for it while the radio is on and nothing is associated.
#
# Listed by UUID and TIMESTAMP, which carry no colons, so nmcli's \:-escaping
# of names never reaches awk (the same reading as segno-wifi-retry). The SSID
# comes from each profile itself rather than from its name.
saved_status_json() {
    listing=$(nmcli -t -f UUID,TYPE,AUTOCONNECT,TIMESTAMP connection show 2>/dev/null \
        | awk -F: '$2 ~ /wireless/ { print $4 "\t" $1 "\t" $3 }' | sort -rn)
    first=1
    last=
    printf '"saved":['
    while IFS="$(printf '\t')" read -r stamp uuid auto; do
        [ -n "$uuid" ] || continue
        ssid=$(profile_field "$uuid" 802-11-wireless.ssid)
        [ -n "$ssid" ] || continue
        if [ -z "$last" ] && [ "${stamp:-0}" -gt 0 ] 2>/dev/null; then
            last=$ssid
        fi
        autoconnect=true
        case "$auto" in no|false) autoconnect=false ;; esac
        if [ "$first" -eq 1 ]; then first=0; else printf ','; fi
        printf '{"ssid":"%s","autoconnect":%s}' "$(json_escape "$ssid")" "$autoconnect"
    done <<EOF
$listing
EOF
    printf '],"last":"%s"' "$(json_escape "$last")"
}

do_status_nm() {
    wifi_radio=$(nmcli -t -f WIFI radio 2>/dev/null || echo disabled)
    enabled=false
    case "$wifi_radio" in enabled|on) enabled=true ;; esac

    if [ "$enabled" != true ]; then
        printf '{"supported":true,"enabled":false,"connected":false,"connecting":false,"ssid":"","ip":"","signal":0,%s}\n' \
            "$(saved_status_json)"
        return 0
    fi

    state=$(nmcli -t -f GENERAL.STATE device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.STATE://p' | head -n1)
    connected=false
    connecting=false
    case "$state" in
        100\ *|*\(connected\)*) connected=true ;;
        # prepare (40) to secondaries (90): an activation in flight, the
        # app's own or one NetworkManager started by itself. ssid is then the
        # network it is joining.
        [4-9]0\ *) connecting=true ;;
    esac

    ssid=$(nmcli -t -f GENERAL.CONNECTION device show "$IFACE" 2>/dev/null \
        | sed -n 's/^GENERAL.CONNECTION://p' | head -n1)
    case "$ssid" in ''|--*) ssid= ;; esac

    ip=$(nmcli -t -f IP4.ADDRESS device show "$IFACE" 2>/dev/null \
        | sed -n 's/^IP4.ADDRESS\[[0-9]*\]://p' | head -n1 | cut -d/ -f1)

    signal=0
    if [ "$connected" = true ] && [ -n "$ssid" ]; then
        signal=$(nmcli -t -f IN-USE,SIGNAL device wifi list ifname "$IFACE" 2>/dev/null \
            | awk -F: '$1=="*" {print $2; exit}')
        [ -n "$signal" ] || signal=0
    fi

    printf '{"supported":true,"enabled":true,"connected":%s,"connecting":%s,"ssid":"%s","ip":"%s","signal":%s,%s}\n' \
        "$connected" "$connecting" "$(json_escape "${ssid:-}")" "$(json_escape "${ip:-}")" "$signal" \
        "$(saved_status_json)"
}

do_radio_nm() {
    onoff=$1
    case "$onoff" in on|off) ;; *) log "radio needs on|off"; return 2 ;; esac
    nmcli radio wifi "$onoff" >/dev/null
    echo '{}'
}

# Never switches the radio on: the Network page scans every few seconds while
# it is open, and a scan landing just after the Wi-Fi switch went off must not
# undo it.
do_scan_nm() {
    nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
    sleep 2

    raw=$(mktemp)
    ranked=$(mktemp)
    nmcli -t -f SSID,SIGNAL,SECURITY device wifi list ifname "$IFACE" 2>/dev/null >"$raw" || true

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        security=${line##*:}
        rest=${line%:*}
        signal=${rest##*:}
        # Terse output escapes ':' and '\\' in the name; the rest are numbers
        # and words, so the name is everything before them, unescaped.
        ssid=$(printf '%s' "${rest%:*}" | sed 's/\\\(.\)/\1/g')
        [ -n "$ssid" ] || continue
        case "$ssid" in --*) continue ;; esac
        secured=true
        case "$security" in ''|--*) secured=false ;; esac
        ssid_safe=$(printf '%s' "$ssid" | tr '\t' ' ')
        printf '%s\t%s\t%s\n' "$ssid_safe" "${signal:-0}" "$secured"
    done <"$raw" | awk -F'\t' '
        {
            ssid=$1; sig=$2+0; sec=$3
            if (!(ssid in best) || sig > best[ssid]) {
                best[ssid]=sig
                secured[ssid]=sec
            }
        }
        END {
            for (s in best) printf "%s\t%d\t%s\n", s, best[s], secured[s]
        }
    ' | sort -t"$(printf '\t')" -k2,2nr >"$ranked"

    # A saved network that is out of range still belongs in the list. Otherwise
    # the only way to forget one is to be connected to it, which is impossible
    # precisely when the saved profile is the thing that will not connect
    # (#471). inRange says whether the scan actually saw it — carried
    # explicitly because signal is dBm on some paths and 0-100 quality on
    # others, so no sentinel value is safe.
    saved=$(mktemp)
    saved_ssids >"$saved"
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        if ! cut -f1 "$ranked" | grep -qxF "$name"; then
            printf '%s\t0\ttrue\tfalse\n' "$name" >>"$ranked"
        fi
    done <"$saved"

    first=1
    printf '['
    while IFS="$(printf '\t')" read -r ssid signal secured in_range; do
        [ -n "$ssid" ] || continue
        [ -n "$in_range" ] || in_range=true
        is_saved=false
        grep -qxF "$ssid" "$saved" && is_saved=true
        if [ "$first" -eq 1 ]; then
            first=0
        else
            printf ','
        fi
        printf '{"ssid":"%s","signal":%s,"secured":%s,"saved":%s,"inRange":%s}' \
            "$(json_escape "$ssid")" "$signal" "$secured" "$is_saved" "$in_range"
    done <"$ranked"
    printf ']\n'
    rm -f "$raw" "$ranked" "$saved"
}

# UUIDs of every saved wifi profile for this SSID, matched by connection name
# or 802-11-wireless.ssid. Both are read one profile at a time, unescaped, so
# a name with a colon in it matches.
profile_uuids_for_ssid() {
    ssid=$1
    wifi_profile_uuids | while IFS= read -r uuid; do
        [ -n "$uuid" ] || continue
        if [ "$(profile_field "$uuid" connection.id)" = "$ssid" ] \
            || [ "$(profile_field "$uuid" 802-11-wireless.ssid)" = "$ssid" ]
        then
            printf '%s\n' "$uuid"
        fi
    done
}

profile_uuid_for_ssid() { profile_uuids_for_ssid "$1" | head -n1; }

do_forget_nm() {
    profile_uuids_for_ssid "$1" | while IFS= read -r uuid; do
        nmcli connection delete uuid "$uuid" >/dev/null 2>&1 || true
    done
    echo '{}'
}

# A UUID for a profile this helper creates, so it is activated and, on
# failure, deleted by that UUID — never by a name another profile may share.
new_uuid() {
    { cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen; } \
        | tr '[:upper:]' '[:lower:]'
}

# The key as one passwd-file line. nmcli reads that file with backslash
# escapes and strips unescaped spaces at either end, so every backslash and
# space is escaped and the key arrives byte for byte. Builtins and stdin only:
# the key is never in any argv.
write_passwd_file() {
    printf '802-11-wireless-security.psk:' >"$1"
    printf '%s' "$2" | sed 's/\\/\\\\/g; s/ /\\ /g' >>"$1"
    printf '\n' >>"$1"
}

# Activates a saved profile on its stored key. NetworkManager does not always
# use the key it has stored. When the link drops during the 4-way handshake
# (handle_8021x_or_psk_auth_fail in nm-device-wifi.c), or a join times out
# on a profile that has not connected before (supplicant_connection_timeout_cb),
# it asks secret agents for a NEW key (NM_SECRET_AGENT_GET_SECRETS_FLAG_
# REQUEST_NEW). A headless console runs none, so the request fails with "No
# agents were available for this request", the activation ends as
# `no-secrets`, and NM blocks the profile from autoconnect until an agent
# registers (nm-policy.c), while the key sits in the keyfile (#1326). nmcli
# reading a passwd-file is the agent that answers, with the stored key. Open
# networks have no key and go up plainly.
up_saved() {
    up_uuid=$1
    up_wait=$2
    up_cursor=${3:-}
    up_epoch=${4:-}
    up_key=$(nmcli -s -e no -g 802-11-wireless-security.psk connection show uuid "$up_uuid" 2>/dev/null || true)
    if [ -z "$up_key" ]; then
        nmcli --wait "$up_wait" connection up uuid "$up_uuid"
        return
    fi
    up_keyf=$(mktemp)
    chmod 600 "$up_keyf"
    write_passwd_file "$up_keyf" "$up_key"
    up_rc=0
    up_with_key "$up_uuid" "$up_wait" "$up_keyf" "$up_cursor" "$up_epoch" || up_rc=$?
    rm -f "$up_keyf"
    up_keyf=
    return "$up_rc"
}

# Activates profile <uuid> within <secs>, answering NM's request for its key
# from passwd-file <file>. Every activation that hands over a key goes
# through here.
#
# nmcli registers its agent before it asks for the activation, and NM answers
# a new agent by auto-activating whichever profile it had blocked for missing
# secrets (nm-policy secret_agent_registered). Ours then lands while that one
# is still in config, NM drops the first without finishing it, and the bench
# console sat with an orphaned activation stuck in "getting IP
# configuration", reporting itself offline while traffic flowed (#1326). So
# the device's autoconnect is paused for the length of the up: NM starts
# nothing on wlan0 by itself, and an explicit activation is unaffected. Only
# a device that may autoconnect is paused; one the owner disconnected by hand
# is already blocked. Runtime state only: a reboot undoes an interrupted
# pause.
#
# Given the join's <cursor> and <epoch>, the up is watched: once a second
# (JOIN_WATCH_INTERVAL) the helper reads what wpa_supplicant logged since the
# join began, and when
# the access point has refused the key (key_wrong) it ends the activation
# instead of waiting out the rest of <secs> (#1859). wpa_supplicant retries a
# refused key every few seconds until NetworkManager's wait runs out, so
# without this a wrong password took the full 45 s, and the app's retries
# made that minutes. A restore passes neither: the journal since the join
# began holds the failed join's refusals, which say nothing about the
# network being brought back.
up_with_key() {
    if [ "$(nmcli -g GENERAL.AUTOCONNECT device show "$IFACE" 2>/dev/null)" = yes ] \
        && nmcli device set "$IFACE" autoconnect no >/dev/null 2>&1; then
        paused_iface=$IFACE
    fi
    uk_rc=0
    if [ -n "${4:-}${5:-}" ]; then
        nmcli --wait "$2" connection up uuid "$1" passwd-file "$3" &
        uk_pid=$!
        while kill -0 "$uk_pid" 2>/dev/null; do
            if uk_line=$(key_wrong "$(wpa_evidence "${4:-}" "${5:-}")"); then
                log "the access point refused the key; ending the join (${uk_line})"
                nmcli connection down uuid "$1" >/dev/null 2>&1 || true
                break
            fi
            sleep "$JOIN_WATCH_INTERVAL"
        done
        wait "$uk_pid" || uk_rc=$?
    else
        nmcli --wait "$2" connection up uuid "$1" passwd-file "$3" || uk_rc=$?
    fi
    resume_autoconnect
    return "$uk_rc"
}

# Gives back the device autoconnect up_with_key paused, if it paused it.
resume_autoconnect() {
    [ -n "$paused_iface" ] || return 0
    nmcli device set "$paused_iface" autoconnect yes >/dev/null 2>&1 || true
    paused_iface=
}

# The file NetworkManager keeps profile <uuid> in, or empty. UUIDs carry no
# colons, so the rest of the line, read unescaped, is the whole path.
profile_file() {
    nmcli -e no -t -f UUID,FILENAME connection show 2>/dev/null \
        | awk -v u="$1:" 'index($0, u) == 1 { print substr($0, length(u) + 1); exit }'
}

# Sets saved profile <uuid> aside for a join with a key typed for it, with
# autoconnect off and autoconnect-priority <priority>: the changes go to a
# copy NetworkManager keeps in memory (in /run, shadowing the stored file,
# which stays as it was), and the copy holds no key. The activation then has
# to ask an agent for one, and nmcli answers from the passwd-file with the
# typed key. With a key stored (psk-flags 0), NetworkManager asks no agent:
# it activated on the stored key, and the join stored the typed key over it
# whether that key was right or not (#1872). NetworkManager saves the key an
# agent hands it into the profile at once, before the join has tested it
# (nm-settings-connection.c, get_secrets_done_cb), which is also how nmcli
# `device wifi connect` and the desktop applets store a new key; here that
# lands in the copy. persist_psk_and_enable writes the copy to disk once the
# key has connected, and release_profile drops it when it has not.
#
# The key is cleared with ClearSecrets on D-Bus: an update that carries no
# secrets keeps the stored ones (update_auth_cb), so no nmcli modify or edit
# can empty it. A profile NetworkManager already keeps in memory only has no
# stored copy to go back to; the console has none, as every profile the
# helper makes is saved to disk.
#
# Where the profile is stored is read first: release_profile tells the copy
# from it by that path, so without one the join does not go ahead. The hold
# is recorded before the modify, so a helper stopped as the modify returns
# still drops the copy.
hold_profile() {
    held_file=$(profile_file "$1")
    if [ -z "$held_file" ]; then
        log "could not find where the saved network is stored"
        return 1
    fi
    held_uuid=$1
    nmcli connection modify --temporary uuid "$1" \
        connection.autoconnect no \
        connection.autoconnect-priority "$2" || return
    hp_path=$(nmcli -t -f UUID,DBUS-PATH connection show 2>/dev/null \
        | awk -F: -v u="$1" '$1 == u { print $2; exit }')
    busctl call org.freedesktop.NetworkManager "$hp_path" \
        org.freedesktop.NetworkManager.Settings.Connection ClearSecrets
}

# Puts back the profile hold_profile set aside, as stored: removes the copy
# in /run and has NetworkManager load the path again, so the file on disk is
# the profile once more, its key, autoconnect and priority as they were. The
# D-Bus API keeps such a copy under /run (NM_SETTINGS_UPDATE2_FLAG_IN_MEMORY)
# and has no call that drops it; `nmcli connection load` is how NetworkManager
# is told about a keyfile changed by hand.
release_profile() {
    [ -n "$held_uuid" ] || return 0
    rp_file=$(profile_file "$held_uuid")
    held_uuid=
    case "$rp_file" in
        "$held_file") return 0 ;;
        "$NM_RUN_DIR"/*) ;;
        *) return 0 ;;
    esac
    rm -f "$rp_file"
    nmcli connection load "$rp_file" >/dev/null 2>&1 || true
}

# Stores the key on a saved profile through nmcli's editor, fed on stdin: an
# argument would be readable by every process on the console through
# /proc/<pid>/cmdline. The editor strips spaces at either end of a value, so a
# key that starts or ends with one cannot be stored this way and is refused.
store_psk() {
    case "$2" in
        ' '*|*' ')
            log "a password that starts or ends with a space can only be set by joining"
            return 2
            ;;
    esac
    printf 'set 802-11-wireless-security.psk %s\nset 802-11-wireless-security.psk-flags 0\nsave persistent\nquit\n' \
        "$2" | nmcli connection edit uuid "$1" >/dev/null 2>&1
}

# After a successful passwd-file up: make sure the PSK is in the keyfile and
# only then allow NM to auto-activate. Shared by new-join and
# reuse-with-password so the two cannot drift on when autoconnect turns on
# (#963). NetworkManager saves a system-owned key an agent (nmcli, reading the
# passwd-file) hands it, byte for byte; it is written again only when the
# stored one is not the key that just worked. Never in any argv. The modify
# saves to disk, so a profile hold_profile set aside is stored from its copy
# in memory, key and priority included, and the copy is gone.
persist_psk_and_enable() {
    uuid=$1
    psk_val=$2
    if [ "$(nmcli -s -e no -g 802-11-wireless-security.psk connection show uuid "$uuid" 2>/dev/null || true)" != "$psk_val" ]; then
        store_psk "$uuid" "$psk_val" || log "could not store the password"
    fi
    nmcli connection modify uuid "$uuid" \
        wifi-sec.psk-flags 0 \
        connection.autoconnect yes \
        >/dev/null 2>&1 || log "could not save the network"
}

# UUID of the wifi connection active on $IFACE right now, or empty. UUIDs carry
# no colons, so the terse listing splits cleanly.
active_wifi_uuid() {
    nmcli -t -f UUID,TYPE,DEVICE connection show --active 2>/dev/null \
        | awk -F: -v dev="$IFACE" '$2 ~ /wireless/ && $3 == dev { print $1; exit }'
}

# One radio cannot hold the old link while it joins a new one: activating a
# second profile on wlan0 drops the first. So a join that fails brings back
# whatever was active before it started, and says so (#1270 D13). Best effort:
# if the old network is gone too, there is nothing better to fall back to.
restore_previous() {
    prev=$1
    [ -n "$prev" ] || return 0
    [ "$prev" != "$(active_wifi_uuid)" ] || return 0
    if up_saved "$prev" "$RESTORE_WAIT_SECS" >/dev/null 2>&1; then
        name=$(profile_field "$prev" 802-11-wireless.ssid)
        log "join failed; reconnected to ${name:-$prev}"
        printf '{"restored":"%s"}\n' "$(json_escape "${name:-}")"
    else
        log "join failed; the previous network did not come back"
    fi
}

do_connect_nm() {
    ssid=$1
    # The key comes on stdin: an argument would be readable by every process
    # on the console through /proc/<pid>/cmdline. Empty for an open network
    # or a saved one joined on its stored key.
    psk=
    if [ ! -t 0 ]; then
        IFS= read -r psk || true
    fi
    nmcli radio wifi on >/dev/null 2>&1 || true

    # A saved hidden network never shows in a scan under its name, so it is
    # tried without the check.
    hidden=
    saved_uuid=$(profile_uuid_for_ssid "$ssid")
    if [ -n "$saved_uuid" ]; then
        hidden=$(profile_field "$saved_uuid" 802-11-wireless.hidden)
    fi
    if [ "$hidden" != yes ] && ssid_missing "$ssid"; then
        log "join failed: not-found ($ssid is not in the scan)"
        printf '{"error":"not-found"}\n'
        return 1
    fi
    # The start of this attempt, so join_failure reads only its own evidence.
    since=$(date +%s)
    mark=$(join_mark)

    # Rejoining the network that is up (a new password for it) falls back to
    # that same network: its old key stays stored until the new one works.
    previous=$(active_wifi_uuid)
    existing=$(profile_uuid_for_ssid "$ssid")
    # Whether a refusal in this join may be read as a wrong key, and the
    # join's start for the watch in up_with_key: neither for a key the
    # profile has already connected with (key_proven).
    judge=yes
    watch_mark=$mark
    watch_since=$since
    if [ -n "$existing" ] && key_proven "$existing" "$psk"; then
        judge=no
        watch_mark=
        watch_since=
    fi
    join_priority=$(next_autoconnect_priority)
    errf=$(mktemp)
    passf=
    created=
    set +e
    if [ -n "$existing" ]; then
        # Reuse the saved profile. Deleting it to "reconnect" is how Join on a
        # saved network threw the PSK away and then failed (#963).
        if [ -n "$psk" ]; then
            # A typed key is tested on a copy of the profile in memory
            # (hold_profile), so the activation uses it and the stored key
            # stays until it connects. Autoconnect is off on the copy: NM's
            # own activation would race this one, as for a new join.
            hold_profile "$existing" "$join_priority" >"$errf" 2>&1
            rc=$?
            if [ "$rc" -eq 0 ]; then
                passf=$(mktemp)
                chmod 600 "$passf"
                write_passwd_file "$passf" "$psk"
                up_with_key "$existing" "$NM_CONNECT_WAIT_SECS" "$passf" "$watch_mark" "$watch_since" >"$errf" 2>&1
                rc=$?
            fi
            if [ "$rc" -eq 0 ]; then
                # Saved to disk from the copy: nothing is left to drop.
                persist_psk_and_enable "$existing" "$psk"
                held_uuid=
            fi
        else
            # A promptless Join already holds secrets; autoconnect stays on.
            nmcli connection modify uuid "$existing" \
                connection.autoconnect yes \
                connection.autoconnect-priority "$join_priority" \
                >"$errf" 2>&1 \
                && up_saved "$existing" "$NM_CONNECT_WAIT_SECS" "$watch_mark" "$watch_since" >"$errf" 2>&1
            rc=$?
        fi
    elif [ -n "$psk" ]; then
        # New secured network. autoconnect stays off until the PSK is stored:
        # otherwise NM auto-activates the profile before it has a key, and
        # that activation races the real up (#963).
        # Create the profile without the PSK, which in argv would be readable
        # by every process, then activate via passwd-file.
        created=$(new_uuid)
        nmcli connection add type wifi ifname "$IFACE" con-name "$ssid" \
            connection.uuid "$created" \
            ssid "$ssid" \
            wifi-sec.key-mgmt wpa-psk \
            wifi-sec.auth-alg open \
            connection.autoconnect no \
            connection.autoconnect-priority "$join_priority" \
            >"$errf" 2>&1
        rc=$?
        if [ "$rc" -eq 0 ]; then
            passf=$(mktemp)
            chmod 600 "$passf"
            write_passwd_file "$passf" "$psk"
            up_with_key "$created" "$NM_CONNECT_WAIT_SECS" "$passf" "$mark" "$since" >"$errf" 2>&1
            rc=$?
            if [ "$rc" -eq 0 ]; then
                persist_psk_and_enable "$created" "$psk"
            fi
        fi
    else
        created=$(new_uuid)
        nmcli connection add type wifi ifname "$IFACE" con-name "$ssid" \
            connection.uuid "$created" \
            ssid "$ssid" \
            connection.autoconnect yes \
            connection.autoconnect-priority "$join_priority" \
            >"$errf" 2>&1 \
            && nmcli --wait "$NM_CONNECT_WAIT_SECS" connection up uuid "$created" \
                >"$errf" 2>&1
        rc=$?
    fi
    set -e
    rm -f "$passf"
    if [ "$rc" -ne 0 ]; then
        join_failure "$(cat "$errf")" "$mark" "$since" "${existing:-$created}" "$ssid" "$judge"
        rm -f "$errf"
        # A failed attempt leaves nothing behind and takes nothing away. A
        # profile made for it is removed, so the list never shows a network
        # saved with a key that did not work. A saved one is never deleted,
        # whatever the failure: only Forget does that. It goes back to what is
        # stored, its key and its own autoconnect, before the previous network
        # comes back on that key.
        if [ -n "$created" ]; then
            nmcli connection delete uuid "$created" >/dev/null 2>&1 || true
        fi
        release_profile
        restore_previous "$previous"
        return 1
    fi
    rm -f "$errf"
    echo '{}'
}

do_disconnect_nm() {
    nmcli device disconnect "$IFACE" >/dev/null 2>&1 || true
    echo '{}'
}

do_autoconnect_nm() {
    ssid=$1
    case "$2" in
        on) value=yes ;;
        off) value=no ;;
        *) log "autoconnect needs on|off"; return 2 ;;
    esac
    uuid=$(profile_uuid_for_ssid "$ssid")
    if [ -z "$uuid" ]; then
        log "no saved network named $ssid"
        return 1
    fi
    nmcli connection modify uuid "$uuid" connection.autoconnect "$value" >/dev/null
    echo '{}'
}

# The key arrives on stdin and reaches NetworkManager on nmcli's stdin, through
# its interactive editor (store_psk). Stored only; the network is not
# activated, so changing the key of a network that is out of range works.
do_set_password_nm() {
    ssid=$1
    psk=
    IFS= read -r psk || [ -n "$psk" ] || true
    if [ -z "$psk" ]; then
        log "set-password needs the key on stdin"
        return 2
    fi
    uuid=$(profile_uuid_for_ssid "$ssid")
    if [ -z "$uuid" ]; then
        log "no saved network named $ssid"
        return 1
    fi
    store_psk "$uuid" "$psk" || {
        rc=$?
        [ "$rc" -eq 2 ] && return 2
        log "could not store the new password"
        return 1
    }
    echo '{}'
}

# Whether the internet is reachable, asked only while the Network page is open
# (#1270 D14): one HEAD request to the update host, over Wi-Fi itself so a
# wired link cannot answer for it. Any HTTP answer, error statuses included,
# proves the path; only no answer at all means no internet.
do_connectivity() {
    if ! command -v curl >/dev/null 2>&1; then
        log "curl is not installed"
        return 1
    fi
    code=$(curl -sS -I -o /dev/null -w '%{http_code}' \
        --interface "$IFACE" --max-time "$CONNECTIVITY_TIMEOUT_SECS" "$CONNECTIVITY_URL" 2>/dev/null) || true
    case "$code" in
        ''|000) echo '{"internet":false}' ;;
        *) echo '{"internet":true}' ;;
    esac
}

# Streams one line, {"event":<what nmcli monitor said>}, for each change
# NetworkManager announces: a device's state (wlan0 connecting, connected,
# disconnected, unavailable when the radio goes off), the primary connection,
# connectivity, and saved profiles created or removed. Runs until it is
# killed. The app runs one while the Network page is open and re-reads status
# after each burst of events, so the page follows the console without
# polling. One long-lived nmcli, started once through posix_spawn, rather
# than a D-Bus client in the app: NetworkManager stays behind this helper,
# like every other Wi-Fi call. nmcli flushes each line (g_print), and the
# shell's printf writes it at once, so nothing waits in a buffer.
do_monitor_nm() {
    nmcli monitor 2>/dev/null | while IFS= read -r line; do
        case "$line" in ''|'NetworkManager is running') continue ;; esac
        printf '{"event":"%s"}\n' "$(json_escape "$line")"
    done
}

require_nm() {
    if ! have_nmcli; then
        log "NetworkManager (nmcli) is not installed"
        return 1
    fi
}

do_status() {
    if ! have_nmcli; then
        echo '{"supported":false,"enabled":false,"connected":false,"connecting":false,"ssid":"","ip":"","signal":0}'
        return 0
    fi
    do_status_nm
}

do_radio() { require_nm && do_radio_nm "$@"; }
do_scan() { require_nm || { echo '[]'; return 1; }; do_scan_nm; }
do_monitor() { require_nm && do_monitor_nm; }
do_connect() { require_nm && do_connect_nm "$@"; }
do_disconnect() { require_nm && do_disconnect_nm; }
do_forget() { require_nm && do_forget_nm "$@"; }
do_autoconnect() { require_nm && do_autoconnect_nm "$@"; }
do_set_password() { require_nm && do_set_password_nm "$@"; }
# nmcli's own chatter goes to stderr: stdout is the JSON contract. Only a
# profile that may auto-join, the ones segno-wifi-retry picks: one a join has
# set aside for a typed key (hold_profile) has autoconnect off and no key, and
# going up on it would end as no-secrets.
do_activate() {
    require_nm || return 1
    if [ "$(nmcli -g connection.autoconnect connection show uuid "$1" 2>/dev/null)" = no ]; then
        log "$1 may not auto-join now; not activating it"
        return 1
    fi
    if up_saved "$1" "${2:-$NM_CONNECT_WAIT_SECS}" >&2; then
        echo '{}'
    else
        return 1
    fi
}

usage() {
    log "usage: $0 status|scan|monitor|connect <ssid>|disconnect|forget <ssid>|radio on|off|autoconnect <ssid> on|off|set-password <ssid>|connectivity|activate <uuid> [secs]"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    scan) do_scan ;;
    monitor) do_monitor ;;
    connect)
        # Exactly the SSID: a key in argv would be readable by every process
        # on the console, so one is refused rather than ignored.
        [ $# -eq 1 ] || usage
        do_connect "$@"
        ;;
    disconnect) do_disconnect ;;
    forget)
        [ $# -ge 1 ] || usage
        do_forget "$1"
        ;;
    radio)
        [ $# -ge 1 ] || usage
        do_radio "$1"
        ;;
    autoconnect)
        [ $# -ge 2 ] || usage
        do_autoconnect "$1" "$2"
        ;;
    set-password)
        [ $# -ge 1 ] || usage
        do_set_password "$1"
        ;;
    connectivity) do_connectivity ;;
    activate)
        [ $# -ge 1 ] || usage
        do_activate "$1" "${2:-}"
        ;;
    *) usage ;;
esac
