#!/bin/sh
# NetworkManager dispatcher hook: a WiFi drop while the console runs gets the
# same retry as boot (#1337). NM blocks a profile after a failure it reads as
# 'no-secrets' and never tries it again (#1326), so a router restart or a
# short drop would otherwise leave the console offline until someone joins by
# hand.
#
# Called as `<interface> <action>`. Only a down matters: of the Wi-Fi device
# the console manages (segno-wifi-ctl iface: a USB adapter when one is
# plugged in, else wlan0, #1963), or of a device that is gone, which is a
# Wi-Fi adapter pulled out while it held the link, so the device managed now
# gets the retry. Starting the unit while it already runs is a no-op. The
# retry itself stands down for a Disconnect by hand or the radio off, waits
# out a network switch, and holds off while the app is performing.
[ "$2" = down ] || exit 0
if [ -e "${SEGNO_SYS_CLASS_NET:-/sys/class/net}/$1" ]; then
    [ "$1" = "${SEGNO_WIFI_IFACE:-$("${SEGNO_WIFI_CTL:-/usr/bin/segno-wifi-ctl}" iface)}" ] || exit 0
fi
exec systemctl start --no-block segno-wifi-retry.service
