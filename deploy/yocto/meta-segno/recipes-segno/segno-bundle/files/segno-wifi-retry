#!/bin/sh
# segno-wifi-retry -- keep activating a saved WiFi network after boot until
# one connects or the budget runs out (#824, #963, #1326).
#
# At boot, the first activation can fail for reasons that have nothing to do
# with the password: iwd autoconnecting off its own store (#824), an empty
# scan cache (#963), or a handshake that times out while the AP is still
# settling (#1326: status 16, "Connected BSS not in scan results"). NM maps
# every one of them to 'no-secrets', blocks autoconnect, and never retries. A
# console with a perfectly good saved network then sits offline until a human
# opens the Network page.
#
# This service is the mechanism-independent backstop: while wlan0 is
# disconnected, activate a saved network the owner lets auto-join, with
# backoff, until it connects or RETRY_FOR seconds have passed. It never writes
# a profile. It stands down for good when the console is online, the radio is
# off, the owner disconnected by hand, or nothing saved may auto-join.
#
# Rules, each learned from a boot that stayed offline:
#
# - Activate on the stored key (segno-wifi-ctl activate, which hands it over
#   through a passwd-file). NetworkManager's iwd backend gives iwd the stored
#   PSK only until the profile has a recorded attempt. After one failure it
#   asks secret agents for a NEW key (REQUEST_NEW in
#   nm_device_iwd_agent_query), and a headless console runs none, so a plain
#   `connection up` fails in milliseconds with "No agents were available"
#   while the key sits in the keyfile (#1326).
# - Never start an activation while one is in flight. The retry's own rescan
#   lets NM auto-activate; a `connection up` on top of that aborts it
#   (net.connman.iwd.Aborted) and throws away the attempt that would have
#   worked (#1326).
# - Rescan and wait for a saved SSID before `connection up`. iwd's periodic
#   scan is off (DisablePeriodicScan), so the scan cache is empty at boot and
#   an activation into it fails at prepare (#963).
# - Prefer the newest saved network that is in range. The newest one overall
#   may be at home while the console is at a venue whose network failed once
#   and is now blocked from NM's own autoconnect.
#
# The owner's choices always win: auto-join off on a network (Network page)
# keeps it out of the candidates, and a Disconnect (`nmcli device disconnect`
# turns the device's autoconnect off until the next activation) ends the
# retry.

set -u

TAG=segno-wifi-retry
SETTLE="${SEGNO_WIFI_RETRY_SETTLE:-8}"            # seconds after start before the first check
RETRY_FOR="${SEGNO_WIFI_RETRY_FOR:-600}"          # total budget; covers a router booting with us after a power cut
BACKOFF="${SEGNO_WIFI_RETRY_BACKOFF:-5}"          # first pause after a failed attempt; doubles
BACKOFF_MAX="${SEGNO_WIFI_RETRY_BACKOFF_MAX:-60}" # longest pause between attempts
POLL="${SEGNO_WIFI_RETRY_POLL:-2}"                # seconds between checks while NM is mid-activation
SCAN_WAIT="${SEGNO_WIFI_RETRY_SCAN_WAIT:-16}"     # seconds to wait for a saved SSID after rescan
UP_WAIT="${SEGNO_WIFI_RETRY_UP_WAIT:-20}"         # activation budget for one attempt
IFACE="${SEGNO_WIFI_IFACE:-wlan0}"
WIFI_CTL="${SEGNO_WIFI_CTL:-/usr/bin/segno-wifi-ctl}"
TAB=$(printf '\t')

log() { echo "$TAG: $*"; }

command -v nmcli >/dev/null 2>&1 || { log "nmcli not present; nothing to do"; exit 0; }

sleep "$SETTLE"
deadline=$(( $(date +%s) + RETRY_FOR ))

# wlan0's NM state word: connected, connecting, disconnected, unavailable, ...
wifi_state() {
  nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null \
    | awk -F: -v dev="$IFACE" '$1 == dev && $2 == "wifi" { split($3, w, " "); print w[1]; exit }'
}

in_flight() {
  [ "$1" = connecting ] || [ "$1" = deactivating ]
}

# Saved WiFi profiles the owner lets auto-join, newest first, one
# "uuid<TAB>ssid" per line, from a `UUID,TYPE,AUTOCONNECT,TIMESTAMP` listing.
# UUIDs contain no colons, so nmcli's \:-escaping of names never enters the
# split. TIMESTAMP is the last successful activation (NM resets it to 0 after
# a failure), so the network the owner used last comes first.
candidates() {
  printf '%s\n' "$1" \
    | awk -F: '$2 == "802-11-wireless" && $3 == "yes" { print $4 "\t" $1 }' \
    | sort -rn | cut -f2 \
    | while IFS= read -r u; do
        printf '%s\t%s\n' "$u" \
          "$(nmcli -e no -g 802-11-wireless.ssid connection show uuid "$u" 2>/dev/null)"
      done
}

# The first candidate whose SSID is in the scan list, or nothing.
first_in_range() {
  visible=$(nmcli -t -e no -f SSID device wifi list ifname "$IFACE" 2>/dev/null)
  printf '%s\n' "$1" | while IFS="$TAB" read -r u s; do
    if [ -n "$s" ] && printf '%s\n' "$visible" | grep -qxF -- "$s"; then
      printf '%s\t%s\n' "$u" "$s"
      break
    fi
  done
}

# One rescan, then poll the list. iwd fills the list as that scan completes;
# asking again every second would restart it. Nothing in range is not a
# reason to skip the up -- hidden networks never appear here -- so the newest
# candidate is the fallback.
pick() {
  nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
  waited=0
  while :; do
    picked=$(first_in_range "$1")
    if [ -n "$picked" ]; then
      printf '%s\n' "$picked"
      return
    fi
    if [ "$waited" -ge "$SCAN_WAIT" ]; then
      log "no saved network in the scan yet; trying the newest anyway" >&2
      printf '%s\n' "$1" | head -1
      return
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

attempt=0
waited_on_nm=no
pause=$BACKOFF
while :; do
  # The owner turned WiFi off? Their call wins -- retrying into a disabled
  # radio would fight the Control Center toggle.
  if [ "$(nmcli radio wifi 2>/dev/null)" = "disabled" ]; then
    log "wifi radio is off; respecting it"
    exit 0
  fi

  # A Disconnect from the Network page turns the device's autoconnect off
  # until the next activation. Reconnecting would undo the owner's action.
  if [ "$(nmcli -g GENERAL.AUTOCONNECT device show "$IFACE" 2>/dev/null)" = "no" ]; then
    log "$IFACE was disconnected by hand; respecting it"
    exit 0
  fi

  state=$(wifi_state)
  if [ "$state" = connected ]; then
    if [ "$attempt" -eq 0 ] && [ "$waited_on_nm" = no ]; then
      log "wifi already connected; no retry needed"
    else
      log "wifi connected"
    fi
    exit 0
  fi

  # NM is mid-activation: its own autoconnect, or a Join from the Network
  # page. Let it finish; whatever it ends in is the next check. It is not our
  # attempt, so it does not advance the backoff.
  if in_flight "$state"; then
    waited_on_nm=yes
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep "$POLL"
    continue
  fi

  listing=$(nmcli -t -f UUID,TYPE,AUTOCONNECT,TIMESTAMP connection show 2>/dev/null)
  if [ -z "$listing" ]; then
    # NM briefly unresponsive is retryable -- do not mistake it for "nothing
    # saved" and give up on a clean exit.
    log "NetworkManager not answering; will retry"
  else
    cands=$(candidates "$listing")
    if [ -z "$cands" ]; then
      log "no saved wifi network may auto-join; nothing to retry"
      exit 0
    fi

    picked=$(pick "$cands")
    uuid=${picked%%"$TAB"*}
    ssid=${picked#*"$TAB"}

    # The rescan above is often what lets NM's own autoconnect fire. If it
    # did, stepping on it is the abort this service must never cause: go
    # back to waiting for it.
    state=$(wifi_state)
    if [ "$state" = connected ] || in_flight "$state"; then
      waited_on_nm=yes
      [ "$(date +%s)" -lt "$deadline" ] || break
      continue
    fi

    attempt=$((attempt + 1))
    log "attempt $attempt: activating $uuid${ssid:+ ($ssid)}"
    # stdout is the helper's JSON; its stderr (nmcli's reason for a failure)
    # goes to the journal, where the next offline boot will be read.
    if "$WIFI_CTL" activate "$uuid" "$UP_WAIT" >/dev/null; then
      log "$uuid activated on attempt $attempt"
      exit 0
    fi
  fi

  now=$(date +%s)
  [ "$now" -lt "$deadline" ] || break
  left=$((deadline - now))
  [ "$pause" -le "$left" ] || pause=$left
  sleep "$pause"
  pause=$((pause * 2))
  [ "$pause" -le "$BACKOFF_MAX" ] || pause=$BACKOFF_MAX
done

log "gave up after $attempt attempt(s) in ${RETRY_FOR}s"
exit 1
