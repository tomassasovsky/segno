#!/bin/sh
# segno-wifi-retry -- keep activating the saved WiFi network after boot until
# it connects or the budget runs out (#824, #963, #1326).
#
# At boot, the first activation can fail for reasons that have nothing to do
# with the password: iwd autoconnecting off its own store (#824), an empty
# scan cache (#963), or a handshake that times out while the AP is still
# settling (#1326: status 16, "Connected BSS not in scan results"). NM maps
# every one of them to 'no-secrets', blocks autoconnect, and never retries. A
# console with a perfectly good saved network then sits offline until a human
# opens the Network page.
#
# This service is the mechanism-independent backstop: while wlan0 is
# disconnected and a saved WiFi profile exists, activate it, with backoff,
# until it connects or RETRY_FOR seconds have passed. It never writes a
# profile and no-ops on a console that is already online, has the radio off,
# or has nothing saved.
#
# Three rules, each learned from a boot that stayed offline:
#
# - Activate on the stored key through passwd-file. NetworkManager's iwd
#   backend hands iwd the stored PSK only until the profile has a recorded
#   attempt. After one failure it asks secret agents for a NEW key
#   (REQUEST_NEW in nm_device_iwd_agent_query), and a headless console runs
#   none, so a plain `connection up` fails in milliseconds with "No agents
#   were available" while the key sits in the keyfile. nmcli reading a
#   passwd-file is the agent that answers (#1326).
# - Never start an activation while one is in flight. The retry's own rescan
#   lets NM auto-activate; a `connection up` on top of that aborts it
#   (net.connman.iwd.Aborted) and throws away the attempt that would have
#   worked (#1326).
# - Rescan and wait for the saved SSID before `connection up`. iwd's periodic
#   scan is off (DisablePeriodicScan), so the scan cache is empty at boot and
#   an activation into it fails at prepare (#963).

set -u

TAG=segno-wifi-retry
SETTLE="${SEGNO_WIFI_RETRY_SETTLE:-8}"            # seconds after start before the first check
RETRY_FOR="${SEGNO_WIFI_RETRY_FOR:-600}"          # total budget; covers a router booting with us after a power cut
BACKOFF="${SEGNO_WIFI_RETRY_BACKOFF:-5}"          # first pause after a failed attempt; doubles
BACKOFF_MAX="${SEGNO_WIFI_RETRY_BACKOFF_MAX:-60}" # longest pause between attempts
POLL="${SEGNO_WIFI_RETRY_POLL:-2}"                # seconds between checks while NM is mid-activation
SCAN_WAIT="${SEGNO_WIFI_RETRY_SCAN_WAIT:-16}"     # seconds to wait for the SSID after rescan
UP_WAIT="${SEGNO_WIFI_RETRY_UP_WAIT:-20}"         # nmcli --wait for one activation
IFACE="${SEGNO_WIFI_IFACE:-wlan0}"

log() { echo "$TAG: $*"; }

command -v nmcli >/dev/null 2>&1 || { log "nmcli not present; nothing to do"; exit 0; }

keyf=
trap 'rm -f "$keyf"' EXIT

sleep "$SETTLE"
deadline=$(( $(date +%s) + RETRY_FOR ))

# wlan0's NM state word: connected, connecting, disconnected, unavailable, ...
wifi_state() {
  nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null \
    | awk -F: -v dev="$IFACE" '$1 == dev && $2 == "wifi" { split($3, w, " "); print w[1]; exit }'
}

ssid_visible() {
  nmcli -t -f SSID device wifi list ifname "$IFACE" 2>/dev/null | grep -qxF "$1"
}

# One rescan, then poll the list. iwd fills the list as that scan completes;
# asking again every second would restart it. Not seeing the SSID is not a
# reason to skip the up -- hidden networks never appear here.
wait_for_ssid() {
  nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
  waited=0
  while ! ssid_visible "$1"; do
    if [ "$waited" -ge "$SCAN_WAIT" ]; then
      log "ssid not in scan yet; activating anyway"
      return
    fi
    sleep 1
    waited=$((waited + 1))
  done
}

# nmcli's passwd-file format: everything after the first colon is the value,
# with backslash and space escaped. Same encoding as segno-wifi-ctl.
write_passwd_file() {
  printf '802-11-wireless-security.psk:' >"$1"
  printf '%s' "$2" | sed 's/\\/\\\\/g; s/ /\\ /g' >>"$1"
  printf '\n' >>"$1"
}

# Activate one saved profile, on its stored key when it has one.
activate() {
  key=$(nmcli -s -e no -g 802-11-wireless-security.psk connection show uuid "$1" 2>/dev/null || true)
  if [ -z "$key" ]; then
    nmcli -w "$UP_WAIT" connection up uuid "$1" >/dev/null 2>&1
    return
  fi
  keyf=$(mktemp)
  chmod 600 "$keyf"
  write_passwd_file "$keyf" "$key"
  nmcli -w "$UP_WAIT" connection up uuid "$1" passwd-file "$keyf" >/dev/null 2>&1
  up_rc=$?
  rm -f "$keyf"
  keyf=
  return "$up_rc"
}

attempt=0
pause=$BACKOFF
while :; do
  # The owner turned WiFi off? Their call wins -- retrying into a disabled
  # radio would fight the Control Center toggle.
  if [ "$(nmcli radio wifi 2>/dev/null)" = "disabled" ]; then
    log "wifi radio is off; respecting it"
    exit 0
  fi

  state=$(wifi_state)
  if [ "$state" = connected ]; then
    if [ "$attempt" -eq 0 ]; then
      log "wifi already connected; no retry needed"
    else
      log "wifi connected"
    fi
    exit 0
  fi

  # NM is mid-activation: its own autoconnect, or a Join from the Network
  # page. Let it finish; whatever it ends in is the next check.
  if [ "$state" = connecting ] || [ "$state" = deactivating ]; then
    [ "$(date +%s)" -lt "$deadline" ] || break
    sleep "$POLL"
    continue
  fi

  # The most recently used saved WiFi profile, by UUID. UUIDs contain no
  # colons, so nmcli's \:-escaping of names (which breaks awk -F: and quoting
  # into `connection up`) never enters the picture. TIMESTAMP is the last
  # successful activation, so a bench unit with several remembered networks
  # retries the one the owner used last.
  listing=$(nmcli -t -f UUID,TYPE,TIMESTAMP connection show 2>/dev/null)
  if [ -z "$listing" ]; then
    # NM briefly unresponsive is retryable -- do not mistake it for "nothing
    # saved" and give up on a clean exit.
    log "NetworkManager not answering; will retry"
  else
    uuid=$(printf "%s\n" "$listing" \
      | awk -F: '$2 == "802-11-wireless" { print $3 "\t" $1 }' \
      | sort -rn | head -1 | cut -f2)
    if [ -z "$uuid" ]; then
      log "no saved wifi profile; nothing to retry"
      exit 0
    fi

    ssid=$(nmcli -e no -g 802-11-wireless.ssid connection show uuid "$uuid" 2>/dev/null || true)
    if [ -n "$ssid" ]; then
      wait_for_ssid "$ssid"
    else
      nmcli device wifi rescan ifname "$IFACE" >/dev/null 2>&1 || true
    fi

    # The rescan above is often what lets NM's own autoconnect fire. If it
    # did, stepping on it is the abort this service must never cause: go
    # back to waiting for it.
    state=$(wifi_state)
    if [ "$state" != connected ] && [ "$state" != connecting ] \
        && [ "$state" != deactivating ]; then
      attempt=$((attempt + 1))
      log "attempt $attempt: activating $uuid${ssid:+ ($ssid)}"
      if activate "$uuid"; then
        log "$uuid activated on attempt $attempt"
        exit 0
      fi
    fi
  fi

  now=$(date +%s)
  [ "$now" -lt "$deadline" ] || break
  left=$((deadline - now))
  [ "$pause" -le "$left" ] || pause=$left
  sleep "$pause"
  pause=$((pause * 2))
  [ "$pause" -le "$BACKOFF_MAX" ] || pause=$BACKOFF_MAX
done

log "gave up after $attempt attempt(s) in ${RETRY_FOR}s"
exit 1
