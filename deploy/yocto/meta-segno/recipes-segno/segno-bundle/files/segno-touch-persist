#!/bin/sh
# Re-derive the touchscreen calibration udev rule from /data at boot.
#
# The matrix lives on the shared /data partition so it survives a RAUC A/B
# update; the udev rule that carries it into libinput lives in /etc, which the
# update replaces. Rebuild the rule from /data on every boot, before the app
# opens its input devices, so a freshly-flashed or freshly-updated slot comes
# up already calibrated.
#
# Same shape as segno-nm-persist / segno-ssh-persist.
#
# See https://github.com/tomassasovsky/segno/issues/659
set -eu

mkdir -p "${SEGNO_TOUCH_DIR:-/data/touch}"
exec /usr/bin/segno-touch-ctl apply
