#!/bin/sh
# Launch the prebuilt Segno GTK bundle as a Wayland client under weston.
# GDK_BACKEND=wayland forces the GTK embedder onto Wayland (not X11/XWayland).
# SEGNO_CONSOLE is already compiled into the bundle; nothing to pass here.
export GDK_BACKEND=wayland

# Persistent data lives on the /data partition (label "data"), which OS/app updates
# never touch. Point HOME (and thus every XDG dir + ~/Documents) there so sessions,
# exports and config are written to /data instead of the rootfs; a reflash then
# preserves them. segno.service pulls in data.mount (RequiresMountsFor=/data), so
# /data is mounted before we get here — but fall back to /root defensively so the
# app still starts if a card somehow lacks the data partition.
# The service runs as root; path_provider (session/export dirs) needs HOME + XDG
# set or it throws MissingPlatformDirectoryException. Create + point them.
if grep -qs ' /data ' /proc/mounts; then
  export HOME=/data
else
  echo "segno-kiosk-launch: /data not mounted, falling back to /root (data will NOT persist across updates)" >&2
  export HOME=/root
fi
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
# AppLog writes $HOME/log/segno.log (rotating); create early so the first
# process-start line never races a missing directory.
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$HOME/log"

# path_provider's getApplicationDocumentsDirectory shells out to `xdg-user-dir
# DOCUMENTS` (xdg-user-dirs package). On this minimal image there is no
# user-dirs.dirs, so without seeding one the lookup fails and the app throws
# MissingPlatformDirectoryException on startup. Seed a default (idempotent) and
# create the dirs so session import/export land under ~/Documents. Validated on
# device: with the xdg-user-dir binary + this file the startup exception is gone.
if [ ! -f "$XDG_CONFIG_HOME/user-dirs.dirs" ]; then
  cat > "$XDG_CONFIG_HOME/user-dirs.dirs" <<'EOF'
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_MUSIC_DIR="$HOME/Documents"
XDG_PICTURES_DIR="$HOME/Documents"
XDG_PUBLICSHARE_DIR="$HOME/Documents"
XDG_TEMPLATES_DIR="$HOME/Documents"
XDG_VIDEOS_DIR="$HOME/Documents"
EOF
fi
mkdir -p "$HOME/Documents" "$HOME/Downloads" "$HOME/Desktop"

# Audio: DIRECT ALSA. This appliance owns the sound card, so SEGNO_ALSA_ONLY tells
# the engine to force miniaudio's ALSA backend (lowest latency, zero IPC) instead
# of the desktop JACK->pulse->alsa preference. No PipeWire/JACK in the image, so no
# pw-jack shim. Runtime rate/buffer changes are safe (the ALSA-duplex uninit
# deadlock is fixed in the engine). The audio thread self-promotes to SCHED_FIFO;
# that needs the RT limits on segno.service.
export SEGNO_ALSA_ONLY=1
# Promote the engine's audio thread to SCHED_FIFO (needs the RT limits on
# segno.service). Required for glitch-free low-latency: at small buffers (64-128
# frames, ~1-3ms) a normal-priority thread misses the period deadline and the
# monitored signal buzzes. Safe now that the ALSA wait loop sleeps (snd_pcm_wait)
# rather than busy-spinning.
export SEGNO_RT_AUDIO=1
# ALSA duplex buffer depth (period count). The engine's startup fixes (capture
# backlog flush + period-aligned reads + self-healing playback resync) make the
# monitor path robust, but a deeper buffer gives both sides a stable cushion
# above the underrun/overrun edge. Two measurements on this appliance, both on
# the bench Pi 4 + Scarlett rig, and both still true:
#
#   1. Monitor path, cold start. 10/10 clean cold starts under a worst-case
#      input transient at 96kHz/64 frames with periods=3 (~5ms), where 2
#      periods intermittently latched a "robotic" monitor. This is what
#      originally picked 3, and nothing here contradicts it: 3 is enough for
#      the monitor path.
#   2. Long performance capture. The same rig at 3 periods drops capture
#      periods over a full-length take (the engine counts and flags them since
#      the dropped-capture-period work); 8 held with none.
#
# 8 ships because the value has to satisfy the harder of the two cases, not the
# one that was measured first. The cost is output buffer depth — five more
# periods, ~1.3ms each by the figure the cold-start run used — which is cheap
# next to a dropped capture period, since a monitor a few ms later is a
# nuisance and a hole in a recorded take is not recoverable.
#
# What would make 8 wrong: a different interface or SoC (the underrun edge is a
# property of this Scarlett + Pi 4 pair), or an engine change that removes the
# capture-side backlog this is padding against. Re-measure BOTH cases before
# lowering it — a clean cold-start run on its own is the evidence that picked 3
# and it was not sufficient. The separately tracked "retest at 2, reclaims
# ~1.3ms" therefore has to clear the capture case too, not just the monitor
# one. The engine's own default stays 2; this override is appliance-only.
export SEGNO_ALSA_PERIODS=8
exec /opt/segno/segno "$@"
