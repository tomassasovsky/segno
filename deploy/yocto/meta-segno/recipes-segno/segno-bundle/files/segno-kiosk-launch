#!/bin/sh
# Launch the prebuilt Segno GTK bundle as a Wayland client under weston.
# GDK_BACKEND=wayland forces the GTK embedder onto Wayland (not X11/XWayland).
# The console build is the only build; nothing to pass here.
export GDK_BACKEND=wayland

# Persistent data lives on the /data partition (label "data"), which OS/app updates
# never touch. Point HOME (and thus every XDG dir + ~/Documents) there so sessions,
# exports and config are written to /data instead of the rootfs; a reflash then
# preserves them. segno.service pulls in data.mount (RequiresMountsFor=/data), so
# /data is mounted before we get here — but fall back to /root defensively so the
# app still starts if a card somehow lacks the data partition.
# The service runs as root; path_provider (session/export dirs) needs HOME + XDG
# set or it throws MissingPlatformDirectoryException. Create + point them.
if grep -qs ' /data ' /proc/mounts; then
  export HOME=/data
else
  echo "segno-kiosk-launch: /data not mounted, falling back to /root (data will NOT persist across updates)" >&2
  export HOME=/root
fi
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
# AppLog writes $HOME/log/segno.log (rotating); create early so the first
# process-start line never races a missing directory.
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$HOME/log"

# path_provider's getApplicationDocumentsDirectory shells out to `xdg-user-dir
# DOCUMENTS` (xdg-user-dirs package). On this minimal image there is no
# user-dirs.dirs, so without seeding one the lookup fails and the app throws
# MissingPlatformDirectoryException on startup. Seed a default (idempotent) and
# create the dirs so session import/export land under ~/Documents. Validated on
# device: with the xdg-user-dir binary + this file the startup exception is gone.
if [ ! -f "$XDG_CONFIG_HOME/user-dirs.dirs" ]; then
  cat > "$XDG_CONFIG_HOME/user-dirs.dirs" <<'EOF'
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_MUSIC_DIR="$HOME/Documents"
XDG_PICTURES_DIR="$HOME/Documents"
XDG_PUBLICSHARE_DIR="$HOME/Documents"
XDG_TEMPLATES_DIR="$HOME/Documents"
XDG_VIDEOS_DIR="$HOME/Documents"
EOF
fi
mkdir -p "$HOME/Documents" "$HOME/Downloads" "$HOME/Desktop"

# Audio: DIRECT ALSA. This appliance owns the sound card, so SEGNO_ALSA_ONLY tells
# the engine to force miniaudio's ALSA backend (lowest latency, zero IPC) instead
# of the desktop JACK->pulse->alsa preference. No PipeWire/JACK in the image, so no
# pw-jack shim. Runtime rate/buffer changes are safe (the ALSA-duplex uninit
# deadlock is fixed in the engine). The audio thread self-promotes to SCHED_FIFO;
# that needs the RT limits on segno.service.
export SEGNO_ALSA_ONLY=1
# Promote the engine's audio thread to SCHED_FIFO (needs the RT limits on
# segno.service). Required for glitch-free low-latency: at small buffers (64-128
# frames, ~1-3ms) a normal-priority thread misses the period deadline and the
# monitored signal buzzes. Safe now that the ALSA wait loop sleeps (snd_pcm_wait)
# rather than busy-spinning.
export SEGNO_RT_AUDIO=1
# ALSA duplex buffer depth (period count). One knob sets two things, and since
# the #809 start-threshold patch they cannot be traded independently:
#
#   * CAPTURE ring depth — headroom against a reader that misses a deadline.
#   * PLAYBACK start threshold — half the ring, floored at the two periods
#     full-duplex needs, so it only moves at all from `periods` >= 5. That
#     threshold IS the steady-state monitor latency: the duplex loop is
#     capture-driven read-then-write, so playback occupancy settles at whatever
#     the stream started with and stays there.
#
# 4 is re-derived, on the bench, 2026-08-27 (#818). It is the deepest count at
# which the start threshold is still at its two-period floor — so the capture
# ring gets 256 frames while the monitor pays nothing for the #809 cushion.
#
# The sweep, Pi 5 + NVMe + Scarlett 4i4, this unit's saved 96kHz/64, 40s of
# steady state per point, playback `delay` + capture `delay` sampled from
# /proc/asound/card2/pcm0{p,c}/sub0/status (p50 frames, and the app's own
# loopback harness for the round trip it reports):
#
#   periods  buffer  occupancy  digital RT  app RT
#      2      128        94        352      4.73ms (predicted)
#      3      192       100        352      4.73ms (predicted)
#      4      256       126        376      4.97ms  <- shipped (predicted)
#      5      320       174        424      5.48ms (predicted)
#      6      384       158        408      5.31ms (predicted)
#      8      512       230        480      6.06ms (measured, the regression)
#
# The app's harness reads about 100 frames above the digital figure — the
# converter/USB term the kernel cannot see. Two independent checks agree on 4:
# the sweep predicts 478 frames, and the settings repository's own #809
# migration (legacy offset + max(0, period*periods/2 - 2*period)) writes 477.
# The stored pre-#809 calibration for this unit was 477. Landing back on it is
# the point: 8 + #809 was 582.
#
# Going below 4 buys 24 frames — 0.25ms — and gives up a third of the capture
# ring. That is not a trade worth making: 3 is the count that once measured
# dropped capture periods over a full-length take.
#
# WHY 8 IS NO LONGER RIGHT, since it was chosen deliberately (#734). It rested
# on the capture-drop measurement above, taken 2026-08-16 on the Pi 4 rig — and
# on the depth being FREE on the monitor side, which was true only while
# miniaudio pinned the start threshold at two periods regardless of the count.
# #809 removed the second half. The first half was measured against a machine
# with two reader-lateness sources that have since been fixed: the capture
# ring's copy-on-write faults (#807) and the `df` fork during a recording
# (#808), both landed 2026-08-25, both after 8 was picked. The launcher's own
# note said what would make 8 wrong — "a different interface or SoC, or an
# engine change that removes the capture-side backlog this is padding against".
# Both happened.
#
# The cushion case was re-run rather than assumed: 5.5 minutes under
# alsa_watch.py at periods=4. Read that run as a NEAR MISS, not a pass: the
# worst appl_ptr stall was 1.41ms against the 1.33ms cushion this config
# leaves, so the margin was exceeded, once. Nothing downstream showed it —
# zero playback resyncs, zero hw_ptr regressions, zero USB errors, no engine
# dropout telemetry — and the evidence is thin in both directions (a single
# occurrence, and the sampler's 350us granularity inflates every duration by
# up to one interval). But "zero resyncs" is an observation over 5.5 minutes,
# not a bound, and a stall past the cushion is an audible click. This depth
# ACCEPTS that risk; it does not eliminate it. What makes it acceptable is
# cause, not count: the #804 hunt's 2-3ms stalls — the ones that justified
# raising the cushion — did not appear at all, their sources (#807, #808)
# having been fixed. If clicks resurface, this is the trade to revisit first.
#
# What that run does NOT cover: the app's UI could not be driven headlessly
# (the uinput keyboard registers but weston does not route it to the surface),
# so the load was the monitor path, not a live take with the performance drain
# writing to NVMe. Judge the take case by ear.
#
# A period is not the same thing on every unit. Rate and buffer_frames are
# persisted per unit on /data by the app, which ships 48000 / 128
# (lib/audio_setup/cubit/audio_setup_state.dart:63-64). At 96kHz/64 one period
# is 0.67ms; at 48kHz/128 it is 2.67ms — the frames double AND the rate halves,
# so every millisecond figure above is 4x, not 2x. Redo the arithmetic rather
# than quoting these numbers. At the shipped default 48kHz/128 the threshold
# is still on its two-period floor at 4, so an un-retuned unit pays no monitor
# latency here — but it does not come out even: its capture ring halves too,
# 1024 -> 512 frames (21.3ms -> 10.7ms). That pair was never re-measured; the
# sweep above is 96kHz/64 only, though #818 asked for both. A capture drop
# reported on a 48kHz/128 unit is the first thing to re-derive.
#
# The engine clamps into [2,8] (`le_alsa_periods_from_env` in
# engine_miniaudio.c, #736) and logs an out-of-range value to stderr rather
# than ignoring it. Past 8 is not reachable: if capture drops reappear on a new
# interface, going deeper is not the lever — find what is making the reader
# late, the way #807 and #808 were found.
#
# Overridable on purpose. The sweep above needed a rootfs edit per point
# because this used to be an unconditional `export`; assigning only when unset
# means a systemd drop-in (Environment=SEGNO_ALSA_PERIODS=N) or an operator's
# `systemctl set-environment` wins, so the next re-derivation — and a revert,
# if a take turns out to click at this depth — costs one command and a restart
# instead of editing an image file. The effective value is logged
# UNCONDITIONALLY, not just when overridden: segno.service is Restart=always,
# so a drop-in left behind outlives every restart while silently moving BOTH
# the monitor latency and the #809 record-offset key (.p8 vs .p4) that decides
# which calibration a take is aligned against. An unexplained latency figure
# has to be answerable from the log rather than by guessing at the unit's
# environment -- which means the ordinary case must say what it ran at too.
# ONE literal for the shipped depth, named so the default and the "is this an
# override" test cannot drift apart -- a stale test here would log a false
# override alarm on every ordinary boot. deploy/rpi/profile-on-device.sh also
# reads this line off the unit when the service is not running.
SEGNO_ALSA_PERIODS_DEFAULT=4
: "${SEGNO_ALSA_PERIODS:=$SEGNO_ALSA_PERIODS_DEFAULT}"
export SEGNO_ALSA_PERIODS
# Numeric compare first, so an explicit "04" is not called an override; the
# string compare is the fallback for a non-numeric value, which the engine
# clamps and which IS worth naming.
if [ "$SEGNO_ALSA_PERIODS" -eq "$SEGNO_ALSA_PERIODS_DEFAULT" ] 2>/dev/null ||
   [ "$SEGNO_ALSA_PERIODS" = "$SEGNO_ALSA_PERIODS_DEFAULT" ]; then
  echo "segno-kiosk-launch: SEGNO_ALSA_PERIODS=$SEGNO_ALSA_PERIODS (shipped default)" >&2
else
  # The raw value is logged, so name the clamp rather than reimplement it:
  # both the engine (le_alsa_periods_from_env) and the Dart record-offset key
  # (alsaPeriodsFromEnvironment) fold this into [2,8], so an out-of-range
  # value here is NOT the depth that ran.
  echo "segno-kiosk-launch: SEGNO_ALSA_PERIODS=$SEGNO_ALSA_PERIODS overrides the shipped $SEGNO_ALSA_PERIODS_DEFAULT -- moves monitor latency AND the record-offset key (clamped into [2,8] by the engine)" >&2
fi
exec /opt/segno/segno "$@"
