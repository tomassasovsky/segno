# Runs the Segno app: ivi-homescreen drawing both HDMI outputs over DRM/KMS,
# with no compositor (segno-kiosk-launch, #1318).
[Unit]
Description=Segno floor-console app
# Wait for the data-grow oneshot (no-op when /data already fills the card) so
# the app never starts mid-resize after flash/OTA onto a larger SD.
After=segno-data-grow.service
Wants=segno-data-grow.service
# The app opens the vc4 card and takes the DRM master itself, which plymouth
# holds for the boot splash until it quits. It also opens the touchscreens
# through libinput itself, so the calibration rule segno-touch-persist
# restores from /data has to exist first.
After=plymouth-quit-wait.service segno-touch-persist.service
# Persistent user data lives on /data (data.mount). Block startup until it is
# mounted so the app never writes sessions/exports to the rootfs by mistake (the
# launcher also guards, but this makes the ordering explicit).
RequiresMountsFor=/data

[Service]
Type=simple
# Real-time audio: the engine puts its ALSA duplex thread on SCHED_FIFO 80 and
# miniaudio locks its buffers. Without these limits (systemd defaults RTPRIO=0,
# MEMLOCK=8M) the setschedparam EPERMs and the thread stays SCHED_OTHER -> jitter
# and xruns. 95 leaves the audio thread (80) room and the USB IRQ thread (rtirq,
# ~90) above it.
LimitRTPRIO=95
LimitMEMLOCK=infinity
# So a native fault in the engine actually dumps (#438). systemd's default
# DefaultLimitCORE leaves the soft limit at 0; the kernel's pipe-to-helper path
# is documented to ignore that, but "documented to ignore" is a weaker guarantee
# than saying it, and the whole point of #438 is that a crash must not be able to
# leave nothing behind. The dump lands on /data via the coredump bind mount, and
# coredump.conf.d caps how much of it is kept.
LimitCORE=infinity
# The app reads USB volumes at the paths segno-usb-mount@.service mounts them
# (/run/media/segno/<generation>-<label>, #1177), so it must stay in the root
# mount namespace: no PrivateMounts=, ProtectSystem=, PrivateTmp= or
# MountFlags= on this unit. run_usb_ctl_tests.sh checks that.
ExecStart=/usr/bin/segno-kiosk-launch
Restart=always
RestartSec=3
# A stop takes about 0.35 s. One stop in 61 on the bench hung until systemd's
# 90 s SIGKILL and left nothing to debug (#1318). Give up after 15 s instead
# (still above the ~10 s a segno-prof sample could hold a stop before it
# attached per sample, #1328), and abort rather than kill: SIGABRT leaves a
# core dump with every thread's stack in coredumpctl.
TimeoutStopSec=15s
TimeoutStopFailureMode=abort
# Time for the core dump the abort exists for: without this, the abort window
# is TimeoutStopSec again and SIGKILL can cut a 300-400 MB dump short.
TimeoutAbortSec=120s

[Install]
WantedBy=multi-user.target
