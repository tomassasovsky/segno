# Removable USB storage: hand every USB block filesystem to systemd (#1177).
#
# The OS mounts drives, not the app: a fork() from the 1.7 GB Flutter process
# stalls the real-time audio thread (#806), so the app only watches the JSON
# that segno-usb-ctl writes. Tagging the device with SYSTEMD_WANTS starts the
# template unit segno-usb-mount@<kname>.service, which is BindsTo= the device
# unit and therefore stops (running `detach`) when the drive is unplugged.
# RUN+= is deliberately not used: udev kills long-running RUN programs and
# they cannot own a mount cleanly. This file sorts before 99-systemd.rules,
# which is what consumes TAG+="systemd" and SYSTEMD_WANTS.
#
# ID_BUS=usb is set by udev's usb_id builtin for USB mass-storage and UAS
# devices. The boot NVMe and any SD card are excluded by kernel name as well,
# so a future USB-attached boot disk cannot be mounted twice.
#
# `change` as well as `add`: a card inserted into a USB reader that is
# already plugged in raises `change` on the reader's sdX, not `add`. A card
# with a partition table adds partitions (an `add` each); a superfloppy card
# (a filesystem on the whole device) only changes sdX. systemd starts the
# units a `change` adds to SYSTEMD_WANTS when they were not wanted before,
# and an empty slot (size 0, the last rule) wants nothing, so each insertion
# is a new want.

# A filesystem on a partition, or on a whole device without a partition table
# (a "superfloppy" stick or card).
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{DEVTYPE}=="partition|disk", \
  ENV{ID_FS_USAGE}=="filesystem", KERNEL!="nvme*|mmcblk*", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="segno-usb-mount@%k.service"

# A blank whole device (no filesystem, no partition table): attach it too, so
# the app can say "not formatted" instead of nothing. Partitions are excluded
# here on purpose; an unformatted partition of a partitioned stick is not the
# drive being blank. A size of 0 is an empty card-reader slot, not a blank
# drive.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{DEVTYPE}=="disk", \
  ENV{ID_FS_USAGE}!="filesystem", ENV{ID_PART_TABLE_TYPE}=="", ATTR{size}!="0", \
  KERNEL!="nvme*|mmcblk*", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="segno-usb-mount@%k.service"

# An empty card-reader slot: tell systemd the disk is not there. Pulling a
# superfloppy card out of a reader leaves sdX in place with size 0; without
# this its device unit stays plugged and the mount unit (BindsTo=) would keep
# a mount of a card that is gone. With it, the unit stops, `detach` runs, and
# the next card is a fresh plug.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{DEVTYPE}=="disk", \
  ATTR{size}=="0", KERNEL!="nvme*|mmcblk*", \
  ENV{SYSTEMD_READY}="0"
