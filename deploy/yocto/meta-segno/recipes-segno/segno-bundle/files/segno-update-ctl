#!/bin/sh
# segno-update-ctl — the privileged update helper the Flutter app drives.
#
# The app runs as the unprivileged kiosk user and does the read-only manifest
# check itself over HTTP; the privileged RAUC work happens here, invoked as
#   pkexec /usr/bin/segno-update-ctl <verb>
# A polkit rule (segno-update-ctl.rules) grants the kiosk user this one action
# without a password — no setuid.
#
# Verbs:
#   install   Download + verify + stage the newest published bundle to the
#             INACTIVE A/B slot. Prints "PROGRESS <0-100>" lines on stdout for
#             the UI, logs detail to stderr, and on success sets the staged +
#             pending markers. Does NOT reboot.
#   reboot    Reboot into the staged slot (the user's explicit "Restart to apply").
#   flash-pedal
#             Flash the published pedal firmware onto the attached Pro Micro
#             (#331 part D). Same PROGRESS/log contract as install. Exits 0 with
#             no work when the channel publishes no firmware or the pedal
#             already runs it, so it is safe to call unconditionally.
#   reconcile-staged
#             Clear /data/.ota-staged-version when it cannot be applied: already
#             running that version, or the inactive rootfs slot is boot-bad
#             (failed tryboot / rollback). Without this, Check Now treats the
#             published build as "already staged" forever after a rollback.
#
# Version model matches segno-ota-check (semver, see its comparator comment):
# install only when the manifest advertises a version newer than the running
# one (/etc/segno/build-version).
set -eu

BASE_URL="${SEGNO_UPDATE_BASE:-https://segno.aquiles.dev/updates/appliance}"
CHANNEL_OVERRIDE_FILE="${SEGNO_CHANNEL_OVERRIDE_FILE:-/data/segno/update-channel}"
CHANNEL_FILE="${SEGNO_CHANNEL_FILE:-/etc/segno/update-channel}"
CUR_FILE="${SEGNO_VERSION_FILE:-/etc/segno/build-version}"
STAGED_FILE="/data/.ota-staged-version"   # on /data so it survives OS updates
PENDING_FLAG="/run/segno-update-pending"  # tmpfs marker: "reboot to activate"

# What firmware the attached pedal is running, as last written by this script.
# On /data, NOT /etc: /etc lives in the A/B slot image, so an OS update would
# reset it and the app would forget what it flashed. This describes attached
# hardware, not the image.
PEDAL_STATE_FILE="${SEGNO_PEDAL_STATE_FILE:-/data/segno/pedal-firmware-version}"
# Written when a flash fails, so the UI can say so instead of silently leaving
# a pedal that may be sitting in its bootloader. Format: "<class> <version>",
# where class is `not-started` (the write never began; the pedal still runs
# whatever it ran before) or `interrupted` (avrdude was handed the bootloader
# port; the pedal may be parked in Caterina with a half-written app section).
# The app branches its failed dialog on the class — the comforting "still on
# its previous firmware" copy is only true for `not-started`.
PEDAL_FAIL_FILE="${SEGNO_PEDAL_FAIL_FILE:-/data/segno/pedal-firmware-failed}"
# Overridable so the test harness can point at stubs and fixtures.
PEDAL_SERIAL_DIR="${SEGNO_PEDAL_SERIAL_DIR:-/dev/serial/by-id}"
AVRDUDE="${SEGNO_AVRDUDE:-avrdude}"
# Seconds to wait for the Caterina bootloader port to appear after the touch
# reset, and for the sketch to re-enumerate afterwards.
PEDAL_PORT_TIMEOUT="${SEGNO_PEDAL_PORT_TIMEOUT:-10}"
# Caterina holds the bootloader open only ~8s before jumping back to the sketch,
# so this budget must stay inside that window.
PEDAL_BOOTLOADER_TRIES="${SEGNO_PEDAL_BOOTLOADER_TRIES:-6}"
# Upper bound on the avrdude write itself.
AVRDUDE_TIMEOUT="${SEGNO_AVRDUDE_TIMEOUT:-120}"
# Seconds a tracked child gets to honour SIGTERM before it is killed. avrdude
# installs no handler, so TERM lands at once unless it is blocked in a USB
# ioctl — which is precisely the stall the abort path exists for, and the only
# case where the KILL is the remaining lever.
FLASH_CHILD_GRACE="${SEGNO_FLASH_CHILD_GRACE:-3}"

log() { echo "segno-update-ctl: $*" >&2; }
progress() { echo "PROGRESS $1"; }

# --- taking the flash down with the script ----------------------------------
#
# The app kills this script (Dart's Process.kill) when the flash stalls or the
# console is torn down. A signal to a shell running `timeout avrdude ...` in
# the FOREGROUND kills only the shell: `exitCode` resolves in milliseconds
# while avrdude carries on as an orphan still owning the Caterina bootloader
# port — so the retry the kill exists to make safe races an unkilled flasher
# for that port. The long-running children are therefore backgrounded, their
# pid tracked, and a TERM/INT trap takes them down before this shell exits.
_flash_child=""

# Signals the tracked child, and its process group when it leads one.
# coreutils `timeout` puts itself and the command it manages in a fresh group,
# so signalling the group is what actually reaches avrdude; busybox's does not,
# hence both. `kill -0 -PID` succeeding proves a group with that id exists, and
# pids are unique, so that group can only be the child's own — never this
# console's.
_signal_flash_child() {
    sig=$1
    if kill -0 "-$_flash_child" 2>/dev/null; then
        kill "-$sig" "-$_flash_child" 2>/dev/null || true
    fi
    kill "-$sig" "$_flash_child" 2>/dev/null || true
}

# SIGTERM the tracked child, give it a real grace period, then kill. TERM
# first on purpose: a KILL landing mid page write is recoverable (Caterina
# lives in the protected boot section and avr109 cannot erase it) but it is
# still a worse place to leave a pedal than a clean abort.
_stop_flash_child() {
    [ -n "$_flash_child" ] || return 0
    kill -0 "$_flash_child" 2>/dev/null || { _flash_child=""; return 0; }
    log "signalled; stopping the in-flight child (pid $_flash_child)"
    _signal_flash_child TERM
    i=0
    while [ "$i" -lt "$FLASH_CHILD_GRACE" ] && kill -0 "$_flash_child" 2>/dev/null
    do
        sleep 1
        i=$((i + 1))
    done
    if kill -0 "$_flash_child" 2>/dev/null; then
        log "child ignored SIGTERM after ${FLASH_CHILD_GRACE}s; killing"
        _signal_flash_child KILL
    fi
    _flash_child=""
}

# `trap ... EXIT` never runs on an untrapped SIGTERM, so every aborted flash
# used to leave its work dir (and a 32 KB hex) behind with nothing to sweep it.
_on_terminate() {
    _stop_flash_child
    [ -z "${work:-}" ] || rm -rf "$work"
    exit 143
}

# Runs "$@" as a tracked background child and waits for it, so the trap above
# can take it down instead of orphaning it. Returns the child's exit status.
run_tracked() {
    "$@" &
    _flash_child=$!
    # Its own name: `sh` has no locals, and callers keep their status in `rc`.
    _tracked_rc=0
    wait "$_flash_child" || _tracked_rc=$?
    _flash_child=""
    return "$_tracked_rc"
}

# Prefer the Settings-written override on /data, then the image-baked marker.
resolve_channel() {
    channel=$(cat "$CHANNEL_OVERRIDE_FILE" 2>/dev/null || true)
    channel=$(printf '%s' "$channel" | tr -d '[:space:]')
    if [ -z "$channel" ]; then
        channel=$(cat "$CHANNEL_FILE" 2>/dev/null || true)
        channel=$(printf '%s' "$channel" | tr -d '[:space:]')
    fi
    [ -n "$channel" ] || channel=production
    printf '%s\n' "$channel"
}

_int() { case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }

# semver_newer OLD NEW — succeeds (exit 0) if NEW is strictly greater than OLD.
# Accepts "X.Y.Z" and "X.Y.Z-<tag>.<n>" (e.g. "0.2.0-experimental.9"); a plain
# release outranks its own prerelease at the same X.Y.Z, and among two
# prereleases sharing a tag the trailing numeric build decides.
semver_newer() {
    old=$1 new=$2
    old_core=${old%%-*}; new_core=${new%%-*}
    old_maj=$(_int "${old_core%%.*}");   new_maj=$(_int "${new_core%%.*}")
    old_rest=${old_core#*.};             new_rest=${new_core#*.}
    old_min=$(_int "${old_rest%%.*}");   new_min=$(_int "${new_rest%%.*}")
    old_pat=$(_int "${old_rest#*.}");    new_pat=$(_int "${new_rest#*.}")

    [ "$new_maj" -gt "$old_maj" ] && return 0
    [ "$new_maj" -lt "$old_maj" ] && return 1
    [ "$new_min" -gt "$old_min" ] && return 0
    [ "$new_min" -lt "$old_min" ] && return 1
    [ "$new_pat" -gt "$old_pat" ] && return 0
    [ "$new_pat" -lt "$old_pat" ] && return 1

    case "$old" in *-*) old_pre=${old#*-} ;; *) old_pre="" ;; esac
    case "$new" in *-*) new_pre=${new#*-} ;; *) new_pre="" ;; esac
    if [ -z "$new_pre" ] && [ -n "$old_pre" ]; then return 0; fi
    if [ -n "$new_pre" ] && [ -z "$old_pre" ]; then return 1; fi
    if [ -z "$new_pre" ] && [ -z "$old_pre" ]; then return 1; fi

    old_tag=${old_pre%.*}; old_num=$(_int "${old_pre##*.}")
    new_tag=${new_pre%.*}; new_num=$(_int "${new_pre##*.}")
    [ "$old_tag" = "$new_tag" ] && [ "$new_num" -gt "$old_num" ]
}

do_install() {
    command -v rauc >/dev/null 2>&1 || { log "rauc not installed"; return 1; }
    channel=$(resolve_channel)
    current=$(cat "$CUR_FILE" 2>/dev/null || echo "0.0.0")

    work=$(mktemp -d /tmp/segno-update.XXXXXX)
    # INT/TERM too: an EXIT trap alone never runs on an untrapped signal, and
    # a killed install would leave a whole staged bundle in /tmp.
    trap 'rm -rf "$work"' EXIT
    trap _on_terminate INT TERM
    progress 0

    if ! curl -fsSL --max-time 30 -o "$work/manifest.json" \
         "$BASE_URL/$channel/manifest.json"; then
        log "manifest fetch failed ($channel)"; return 1
    fi
    version=$(jq -r '.version // "0.0.0"' "$work/manifest.json" 2>/dev/null || echo "0.0.0")
    bundle=$(jq -r '.bundle // empty' "$work/manifest.json" 2>/dev/null || echo "")
    sha=$(jq -r '.sha256 // empty' "$work/manifest.json" 2>/dev/null || echo "")

    if [ -z "$bundle" ] || ! semver_newer "$current" "$version"; then
        log "nothing newer to install (published=$version current=$current)"
        return 1
    fi

    log "downloading v$version: $bundle"
    progress 5
    if ! curl -fsSL --max-time 1800 -o "$work/$bundle" \
         "$BASE_URL/$channel/$bundle"; then
        log "bundle download failed"; return 1
    fi
    progress 40

    # Defence in depth: manifest sha256 (RAUC also verifies the bundle's own
    # X.509 signature against the baked-in keyring — that is the real boundary).
    if [ -n "$sha" ]; then
        actual=$(sha256sum "$work/$bundle" | cut -d' ' -f1)
        if [ "$actual" != "$sha" ]; then
            log "sha256 mismatch (want $sha got $actual) — refusing"; return 1
        fi
    fi

    # Install to the inactive slot, mapping rauc's own "NN% ..." progress into
    # the 40..100 band. A fifo preserves rauc's exit code (a plain pipe loses it
    # under busybox sh, which has no reliable pipefail).
    log "installing v$version to the inactive slot"
    fifo="$work/rauc.fifo"
    mkfifo "$fifo"
    rauc install "$work/$bundle" >"$fifo" 2>&1 &
    rauc_pid=$!
    while IFS= read -r line; do
        pct=$(printf '%s' "$line" | sed -n 's/^ *\([0-9]\{1,3\}\)% .*/\1/p')
        [ -n "$pct" ] && progress $((40 + pct * 60 / 100))
        printf '%s\n' "$line" >&2
    done < "$fifo"
    if ! wait "$rauc_pid"; then
        log "rauc install failed"; return 1
    fi

    echo "$version" > "$STAGED_FILE" 2>/dev/null || true
    : > "$PENDING_FLAG" 2>/dev/null || true
    progress 100
    log "staged v$version to the inactive slot; reboot to apply"
}

# --- pedal firmware (#331 part D) -------------------------------------------
#
# The pedal has no A/B safety net. RAUC can roll the OS back to the other slot;
# a half-written 32U4 sits in its Caterina bootloader until something reflashes
# it, and on a sealed console there is no picker and no second USB port to do
# that from. So every gate below is about NOT starting a write that cannot
# finish, and about leaving a legible trail when one fails anyway.

# USB product substrings that identify "the pedal" sketch CDC port in by-id.
# Newest first. Pre-flash discovery must still see older names — otherwise a
# rename ships an updater that cannot find the board it needs to reflash
# (GATE 1 looks here; the new hex only appears after avrdude succeeds).
PEDAL_PRODUCT_GLOBS='Segno_Loopstation VAMP_Loopstation'

# Current product string only — what a successful flash of today's hex must
# re-enumerate as. Used for GATE 4 so a failed write that leaves the old
# sketch running is not recorded as success.
PEDAL_FLASHED_PRODUCT_GLOB='Segno_Loopstation'

# Prints a sketch CDC path matching any known product string, or nothing.
pedal_port() {
    for name in $PEDAL_PRODUCT_GLOBS; do
        for dev in "$PEDAL_SERIAL_DIR"/*"$name"*; do
            [ -e "$dev" ] || continue
            printf '%s\n' "$dev"
            return 0
        done
    done
    return 1
}

# Prints a sketch CDC path matching the product string baked into the hex we
# just wrote, or nothing.
pedal_flashed_port() {
    for dev in "$PEDAL_SERIAL_DIR"/*"$PEDAL_FLASHED_PRODUCT_GLOB"*; do
        [ -e "$dev" ] || continue
        printf '%s\n' "$dev"
        return 0
    done
    return 1
}

# Waits up to PEDAL_PORT_TIMEOUT for the NEW sketch to re-enumerate after a
# flash. Never use this to find the bootloader — see wait_for_bootloader.
wait_for_pedal_port() {
    i=0
    while [ "$i" -lt "$PEDAL_PORT_TIMEOUT" ]; do
        if port=$(pedal_flashed_port); then printf '%s\n' "$port"; return 0; fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

# The by-id port names present right now, one per line.
pedal_ports() { ls "$PEDAL_SERIAL_DIR" 2>/dev/null; }

# Waits for the Caterina bootloader to enumerate after the touch reset and
# prints its device path.
#
# Identified by DIFFERENCE against the pre-reset snapshot, never by name.
# Caterina advertises its OWN descriptors — observed on this hardware as
# "usb-Arduino_LLC_Arduino_Leonardo-if00" — not the sketch's build.usb_product,
# so no product-name match can ever find it. Matching the pedal's name here is
# what broke the first on-device attempt: the glob could only ever match the
# SKETCH, so it sat out the bootloader window (~8s before Caterina gives up and
# jumps back), matched the sketch when it returned, and handed avrdude a port
# that speaks MIDI and will never answer avr109 — which hung the update at 95%.
#
# Polls faster than one second because that window is the whole budget.
wait_for_bootloader() {
    before=$1
    i=0
    while [ "$i" -lt "$PEDAL_BOOTLOADER_TRIES" ]; do
        found=$(pedal_ports | while IFS= read -r p; do
            [ -n "$p" ] || continue
            printf '%s\n' "$before" | grep -qxF "$p" && continue
            printf '%s/%s\n' "$PEDAL_SERIAL_DIR" "$p"
            break
        done)
        if [ -n "$found" ]; then
            printf '%s\n' "$found"
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    return 1
}

# The Caterina 1200bps touch: opening the CDC port at 1200 baud and dropping
# DTR makes the sketch jump to its bootloader, which re-enumerates as a
# different device. This is what `arduino-cli upload` does for you.
pedal_touch_reset() {
    port=$1
    stty -F "$port" 1200 hupcl 2>/dev/null || true
    sleep 2
}

# The class recorded in the failure marker, or nothing.
pedal_fail_class() {
    [ -f "$PEDAL_FAIL_FILE" ] || return 0
    cut -d' ' -f1 "$PEDAL_FAIL_FILE" 2>/dev/null || true
}

# The firmware version recorded in the failure marker, or nothing. `-s` so a
# legacy single-field marker (pre-#670, a bare version) reports NO version
# rather than reporting its own class field as one — cut without it passes a
# delimiter-less line through whole.
pedal_fail_version() {
    [ -f "$PEDAL_FAIL_FILE" ] || return 0
    cut -s -d' ' -f2 "$PEDAL_FAIL_FILE" 2>/dev/null || true
}

# write_pedal_fail CLASS [VERSION] — records why a flash failed, for the UI.
#
# Never downgrades: an existing `interrupted` marker means a write began and no
# flash has completed since — the pedal is (or may be) holding a half-written
# app section. A LATER attempt that fails before touching the pedal (no
# manifest, no port — the parked pedal presents no sketch port at all) does not
# change what the pedal is left holding, so `not-started` may only overwrite a
# marker that is itself provably `not-started`. Anything else is kept: legacy
# markers (pre-#670, a bare version, only ever written on interrupted paths)
# and empty/garbled markers (a write cut short) all mean "a write may have
# begun". Only a successful flash clears the marker.
#
# The write itself is tmp + mv so a power cut mid-write leaves either the old
# marker or the new one, never a truncated file that would launder the class.
write_pedal_fail() {
    class=$1
    version=${2:-}
    if [ "$class" = "not-started" ] && [ -f "$PEDAL_FAIL_FILE" ] && \
       [ "$(pedal_fail_class)" != "not-started" ]; then
        log "keeping earlier failure marker (not provably not-started)"
        return 0
    fi
    mkdir -p "$(dirname "$PEDAL_FAIL_FILE")" 2>/dev/null || true
    tmp="$PEDAL_FAIL_FILE.tmp.$$"
    # Every failure here is swallowed on purpose: `set -eu` makes a non-zero
    # return from inside an `if ... then` body abort the whole script, and
    # losing the marker must not also lose the exit code that classifies the
    # failure. But it is LOGGED — a marker that silently fails to land leaves
    # the previous one in place, and the app then shows that pedal's dialog.
    if [ -n "$version" ]; then
        printf '%s %s\n' "$class" "$version" > "$tmp" 2>/dev/null || {
            log "could not write failure marker ($class) to $tmp"
            rm -f "$tmp" 2>/dev/null || true
            return 0
        }
    else
        printf '%s\n' "$class" > "$tmp" 2>/dev/null || {
            log "could not write failure marker ($class) to $tmp"
            rm -f "$tmp" 2>/dev/null || true
            return 0
        }
    fi
    if mv -f "$tmp" "$PEDAL_FAIL_FILE" 2>/dev/null; then
        log "recorded failure marker: $class${version:+ }$version"
    else
        log "could not replace $PEDAL_FAIL_FILE; keeping the earlier marker"
        rm -f "$tmp" 2>/dev/null || true
    fi
}

# clear_stale_fail_marker VERSION — drops a failure marker left by an EARLIER
# campaign once the pedal has proven it is not the pedal that marker describes.
#
# An `interrupted` marker claims the pedal may be parked in Caterina with a
# half-written app section. A pedal that answers on its SKETCH port disproves
# exactly that: it booted, it enumerated, it is running a firmware. Without
# this the marker outlives the pedal state it recorded — a board reflashed by
# hand at a workbench keeps it forever, since only a successful OTA flash ever
# clears it, and the next campaign's honest `not-started` failure is refused as
# a downgrade and shows "may need to be flashed again from a computer" for a
# healthy pedal.
#
# Scoped to markers from a DIFFERENT version, because "answers on its sketch
# port" does not disprove a marker THIS campaign wrote. The app retries a
# failed flash by invoking this verb again, so attempt 2 runs the whole
# function afresh and the no-downgrade rule — which lives inside one
# invocation's view of the file — cannot see what attempt 1 recorded. A pedal
# whose half-written app still enumerates under the product name (Caterina
# times out and jumps to it) would otherwise have attempt 1's `interrupted`
# deleted here and attempt 2's `not-started` written over the gap, and the
# dialog would tell the user their pedal still runs its previous firmware.
#
# The earlier argument for clearing unconditionally — "campaign A leaves
# `interrupted 1.0.0`, the channel publishes 1.1.0, and the retry then writes
# `not-started 1.1.0`" — does not hold: the clear sits AFTER GATE 1, so a
# failure that never finds the pedal never reaches it and the no-downgrade rule
# refuses the write anyway.
#
# A marker with no version field is by definition not this campaign's: every
# `interrupted` path records one, and the versionless `not-started` markers
# predate the manifest fetch (or are legacy, pre-#670) and are overwritable in
# any case.
clear_stale_fail_marker() {
    [ -f "$PEDAL_FAIL_FILE" ] || return 0
    marked=$(pedal_fail_version)
    if [ -n "$marked" ] && [ "$marked" = "$1" ]; then
        log "keeping this campaign's own failure marker ($marked)"
        return 0
    fi
    log "pedal answers on its sketch port; dropping the stale failure marker"
    rm -f "$PEDAL_FAIL_FILE" 2>/dev/null \
        || log "could not clear $PEDAL_FAIL_FILE"
}

# What the pedal is running, as recorded by the last successful flash.
# 0.0.0 stands for "never flashed by us", which always looks out of date.
pedal_current_version() {
    version=""
    if [ -f "$PEDAL_STATE_FILE" ]; then
        version=$(cut -d' ' -f1 "$PEDAL_STATE_FILE" 2>/dev/null || true)
    fi
    [ -n "$version" ] || version=0.0.0
    printf '%s\n' "$version"
}

# Prints the firmware version this pedal is about to be flashed with, or
# nothing. Only the app calls this, to decide whether to put a blocking
# "finishing update" screen in front of the looper: programming drops the pedal
# into its bootloader, where the footswitches are dead and the ring is dark, so
# a user left in the looper would read the update as a broken pedal.
#
# Everything that is not "yes, work is about to happen" is silence and exit 0 —
# no firmware published, already up to date, pedal unplugged, no network. The
# gate is a courtesy; refusing to start the app because the manifest was
# unreachable would be a far worse failure than not showing it.
do_pedal_pending() {
    channel=$(resolve_channel)
    work=$(mktemp -d /tmp/segno-pedal-pending.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    trap _on_terminate INT TERM

    curl -fsSL --max-time 10 -o "$work/manifest.json" \
        "$BASE_URL/$channel/manifest.json" 2>/dev/null || return 0

    fw_version=$(jq -r '.pedalFirmware.version // empty' "$work/manifest.json" \
        2>/dev/null || echo "")
    [ -n "$fw_version" ] || return 0
    [ "$(pedal_current_version)" != "$fw_version" ] || return 0

    # No pedal, no flash, so no gate — the app must not stall on a console
    # whose pedal is simply unplugged.
    pedal_port >/dev/null 2>&1 || return 0

    printf '%s\n' "$fw_version"
}

do_flash_pedal() {
    command -v "$AVRDUDE" >/dev/null 2>&1 || {
        log "avrdude not installed"
        write_pedal_fail not-started
        return 1
    }
    channel=$(resolve_channel)

    work=$(mktemp -d /tmp/segno-pedal.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    trap _on_terminate INT TERM
    # Nothing else sweeps these: a write_pedal_fail killed between its printf
    # and its mv leaves one on /data forever.
    rm -f "$PEDAL_FAIL_FILE".tmp.* 2>/dev/null || true
    progress 0

    if ! curl -fsSL --max-time 30 -o "$work/manifest.json" \
         "$BASE_URL/$channel/manifest.json"; then
        log "manifest fetch failed ($channel)"
        write_pedal_fail not-started
        return 1
    fi

    hex=$(jq -r '.pedalFirmware.hex // empty' "$work/manifest.json" 2>/dev/null || echo "")
    fw_version=$(jq -r '.pedalFirmware.version // empty' "$work/manifest.json" 2>/dev/null || echo "")
    fw_sha=$(jq -r '.pedalFirmware.sha256 // empty' "$work/manifest.json" 2>/dev/null || echo "")
    fw_proto=$(jq -r '.pedalFirmware.protocolVersion // 0' "$work/manifest.json" 2>/dev/null || echo 0)

    # No firmware on this channel is a normal state, not a failure: every
    # manifest published before the artifact existed looks like this.
    if [ -z "$hex" ] || [ -z "$fw_version" ]; then
        log "no pedal firmware published on $channel; nothing to do"
        progress 100
        return 0
    fi

    current=$(pedal_current_version)
    if [ "$current" = "$fw_version" ]; then
        log "pedal already runs $fw_version; nothing to do"
        progress 100
        return 0
    fi

    # GATE 1 — the pedal must be here before a single byte is downloaded.
    # Flashing "the pedal" while it is unplugged would either do nothing or,
    # worse, write this image to whatever else answers to the port.
    if ! port=$(pedal_port); then
        log "no pedal attached; refusing to flash"
        write_pedal_fail not-started "$fw_version"
        return 1
    fi
    log "pedal at $port; publishing $fw_version (current $current)"
    clear_stale_fail_marker "$fw_version"

    progress 10
    if ! run_tracked curl -fsSL --max-time 300 -o "$work/$hex" \
         "$BASE_URL/$channel/$hex"; then
        log "firmware download failed"
        write_pedal_fail not-started "$fw_version"
        return 1
    fi
    progress 30

    # GATE 2 — checksum before writing. Unlike the RAUC bundle, a .hex carries
    # no signature of its own, so this is the ONLY integrity check standing
    # between a corrupted download and a bricked pedal. A missing checksum is
    # therefore refused rather than skipped (install treats it as optional
    # because RAUC verifies the bundle signature independently).
    if [ -z "$fw_sha" ]; then
        log "manifest publishes no sha256 for $hex; refusing to flash unverified firmware"
        write_pedal_fail not-started "$fw_version"
        return 1
    fi
    actual=$(sha256sum "$work/$hex" | cut -d' ' -f1)
    if [ "$actual" != "$fw_sha" ]; then
        log "sha256 mismatch (want $fw_sha got $actual) — refusing"
        write_pedal_fail not-started "$fw_version"
        return 1
    fi
    progress 40

    # GATE 3 — still attached after the download (which can take a while).
    if ! pedal_port >/dev/null; then
        log "pedal disappeared during download; refusing to flash"
        write_pedal_fail not-started "$fw_version"
        return 1
    fi

    # Snapshot BEFORE the touch so the bootloader can be spotted as the port
    # that was not there a moment ago.
    ports_before=$(pedal_ports)
    log "resetting $port into the bootloader"
    pedal_touch_reset "$port"
    if ! boot_port=$(wait_for_bootloader "$ports_before"); then
        log "bootloader never appeared after the touch reset; pedal left untouched"
        # Caterina jumps back to the sketch after its ~8s window, so nothing
        # was written — the previous firmware still runs.
        write_pedal_fail not-started "$fw_version"
        return 1
    fi
    log "bootloader at $boot_port"
    progress 50

    # No -V: avrdude verifies the readback against the image by default, and
    # that verification is the difference between "wrote something" and "wrote
    # this". Losing it to save a few seconds would defeat the point.
    # Hard timeout: avrdude blocks on a port that never answers, and without a
    # bound it takes the whole update UI down with it (observed: the progress
    # bar frozen at 95% with no way back). A flash of a 32 KB image over CDC is
    # seconds; anything near the bound is already a failure.
    log "flashing $hex via $boot_port"
    # `rc=$?` inside `if ! cmd` would read the status of the NEGATION, not of
    # avrdude, so capture it on the failure path instead.
    #
    # Run through run_tracked, not in the foreground: a foreground avrdude
    # survives the app's kill as an orphan still holding the bootloader port.
    rc=0
    run_tracked timeout "$AVRDUDE_TIMEOUT" "$AVRDUDE" -p atmega32u4 -c avr109 \
        -P "$boot_port" -b 57600 -U "flash:w:$work/$hex:i" >&2 || rc=$?
    if [ "$rc" -ne 0 ]; then
        [ "$rc" = 124 ] && log "avrdude timed out after ${AVRDUDE_TIMEOUT}s"
        log "avrdude failed; pedal may be sitting in its bootloader"
        write_pedal_fail interrupted "$fw_version"
        return 1
    fi
    progress 90

    # GATE 4 — the sketch has to come back. avrdude exiting 0 means the write
    # verified, not that the firmware runs; if the pedal never re-enumerates,
    # say so rather than recording a version that is not actually running.
    if ! wait_for_pedal_port >/dev/null; then
        log "pedal did not re-enumerate after flashing"
        write_pedal_fail interrupted "$fw_version"
        return 1
    fi

    # "<semver> <protocol>" — the app reads field 2 to know what wire version
    # it may encode at, which is the whole point of recording this.
    mkdir -p "$(dirname "$PEDAL_STATE_FILE")" 2>/dev/null || true
    echo "$fw_version $fw_proto" > "$PEDAL_STATE_FILE"
    rm -f "$PEDAL_FAIL_FILE" 2>/dev/null || true
    progress 100
    log "pedal flashed to $fw_version (protocol v$fw_proto)"
}

# True when any inactive rootfs slot is marked boot-bad (failed tryboot).
inactive_rootfs_bad() {
    command -v rauc >/dev/null 2>&1 || return 1
    command -v jq >/dev/null 2>&1 || return 1
    rauc status --output-format=json 2>/dev/null \
        | jq -e '
            .slots[] | .[]
            | select(.class=="rootfs" and .state=="inactive" and .boot_status=="bad")
          ' >/dev/null 2>&1
}

do_reconcile_staged() {
    if [ ! -f "$STAGED_FILE" ]; then
        echo '{"cleared":false}'
        return 0
    fi
    staged=$(tr -d '[:space:]' <"$STAGED_FILE" 2>/dev/null || true)
    current=$(tr -d '[:space:]' <"$CUR_FILE" 2>/dev/null || echo "0.0.0")
    [ -n "$staged" ] || {
        rm -f "$STAGED_FILE"
        echo '{"cleared":true,"reason":"empty"}'
        return 0
    }
    # Successfully running the staged build — drop the marker.
    if [ "$staged" = "$current" ]; then
        rm -f "$STAGED_FILE"
        log "cleared staged=$staged (already running)"
        echo '{"cleared":true,"reason":"already-running"}'
        return 0
    fi
    # Rolled back after tryboot: inactive slot bad + staged still ahead of current.
    if inactive_rootfs_bad && semver_newer "$current" "$staged"; then
        rm -f "$STAGED_FILE"
        log "cleared staged=$staged after failed tryboot (inactive rootfs bad)"
        echo '{"cleared":true,"reason":"inactive-slot-bad"}'
        return 0
    fi
    echo '{"cleared":false}'
}

case "${1:-}" in
    install)          do_install ;;
    flash-pedal)      do_flash_pedal ;;
    pedal-pending)    do_pedal_pending ;;
    reconcile-staged) do_reconcile_staged ;;
    reboot)           log "rebooting into the staged slot"; exec systemctl reboot ;;
    *)                log "usage: segno-update-ctl {install|flash-pedal|pedal-pending|reconcile-staged|reboot}"; exit 2 ;;
esac
