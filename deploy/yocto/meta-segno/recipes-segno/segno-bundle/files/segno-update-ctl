#!/bin/sh
# segno-update-ctl — the privileged update helper the Flutter app drives.
#
# The app runs as the unprivileged kiosk user and does the read-only manifest
# check itself over HTTP; the privileged RAUC work happens here, invoked as
#   pkexec /usr/bin/segno-update-ctl <verb>
# A polkit rule (segno-update-ctl.rules) grants the kiosk user this one action
# without a password — no setuid.
#
# Verbs:
#   install   Download + verify + stage the newest published bundle to the
#             INACTIVE A/B slot. Prints "PROGRESS <0-100>" lines on stdout for
#             the UI, logs detail to stderr, and on success sets the staged +
#             pending markers. Does NOT reboot.
#   reboot    Reboot into the staged slot (the user's explicit "Restart to apply").
#   poweroff  Clean halt (`systemctl start poweroff.target`). Does not go through
#             logind — this image has none — so `systemctl poweroff` would fail.
#   reconcile-staged
#             Clear /data/.ota-staged-version when it cannot be applied: already
#             running that version, or the marker was written in an earlier
#             boot and the staged version is still not the one running — the
#             tryboot did not take. That covers boot-bad rollbacks AND the
#             #307 health gate's designed outcome: a slot that boots fine but
#             never gets committed, which RAUC never calls bad. Without this,
#             Check Now treats the published build as "already staged" forever
#             after a rollback.
#
# Version model matches segno-ota-check (semver, see its comparator comment):
# install only when the manifest advertises a version newer than the running
# one (/etc/segno/build-version).
set -eu

BASE_URL="${SEGNO_UPDATE_BASE:-https://segno.aquiles.dev/updates/appliance}"
CHANNEL_OVERRIDE_FILE="${SEGNO_CHANNEL_OVERRIDE_FILE:-/data/segno/update-channel}"
CHANNEL_FILE="${SEGNO_CHANNEL_FILE:-/etc/segno/update-channel}"
CUR_FILE="${SEGNO_VERSION_FILE:-/etc/segno/build-version}"
STAGED_FILE="${SEGNO_STAGED_FILE:-/data/.ota-staged-version}"  # on /data so it survives OS updates
# The boot id current when the marker was written, kept NEXT TO the marker
# rather than inside it: both the app and segno-ota-check parse the marker's
# whole content as a semver, so the marker format cannot grow a second field.
STAGED_BOOT_FILE="${SEGNO_STAGED_BOOT_ID_FILE:-/data/.ota-staged-boot-id}"
BOOT_ID_FILE="${SEGNO_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
# tmpfs marker: "reboot to activate". Overridable because a redirection onto a
# missing /run is FATAL in a POSIX sh (`:` is a special builtin), `|| true` or
# not — the test harness has no /run to point it at.
PENDING_FLAG="${SEGNO_PENDING_FLAG:-/run/segno-update-pending}"

log() { echo "segno-update-ctl: $*" >&2; }
progress() { echo "PROGRESS $1"; }

# `trap ... EXIT` never runs on an untrapped SIGTERM, so a killed install
# would leave its work dir (and a whole staged bundle) in /tmp with nothing to
# sweep it.
_on_terminate() {
    [ -z "${work:-}" ] || rm -rf "$work"
    exit 143
}

# Prefer the Settings-written override on /data, then the image-baked marker.
resolve_channel() {
    channel=$(cat "$CHANNEL_OVERRIDE_FILE" 2>/dev/null || true)
    channel=$(printf '%s' "$channel" | tr -d '[:space:]')
    if [ -z "$channel" ]; then
        channel=$(cat "$CHANNEL_FILE" 2>/dev/null || true)
        channel=$(printf '%s' "$channel" | tr -d '[:space:]')
    fi
    [ -n "$channel" ] || channel=production
    printf '%s\n' "$channel"
}

_int() { case "$1" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }

# semver_newer OLD NEW — succeeds (exit 0) if NEW is strictly greater than OLD.
# Accepts "X.Y.Z" and "X.Y.Z-<tag>.<n>" (e.g. "0.2.0-experimental.9"); a plain
# release outranks its own prerelease at the same X.Y.Z, and among two
# prereleases sharing a tag the trailing numeric build decides.
semver_newer() {
    old=$1 new=$2
    old_core=${old%%-*}; new_core=${new%%-*}
    old_maj=$(_int "${old_core%%.*}");   new_maj=$(_int "${new_core%%.*}")
    old_rest=${old_core#*.};             new_rest=${new_core#*.}
    old_min=$(_int "${old_rest%%.*}");   new_min=$(_int "${new_rest%%.*}")
    old_pat=$(_int "${old_rest#*.}");    new_pat=$(_int "${new_rest#*.}")

    [ "$new_maj" -gt "$old_maj" ] && return 0
    [ "$new_maj" -lt "$old_maj" ] && return 1
    [ "$new_min" -gt "$old_min" ] && return 0
    [ "$new_min" -lt "$old_min" ] && return 1
    [ "$new_pat" -gt "$old_pat" ] && return 0
    [ "$new_pat" -lt "$old_pat" ] && return 1

    case "$old" in *-*) old_pre=${old#*-} ;; *) old_pre="" ;; esac
    case "$new" in *-*) new_pre=${new#*-} ;; *) new_pre="" ;; esac
    if [ -z "$new_pre" ] && [ -n "$old_pre" ]; then return 0; fi
    if [ -n "$new_pre" ] && [ -z "$old_pre" ]; then return 1; fi
    if [ -z "$new_pre" ] && [ -z "$old_pre" ]; then return 1; fi

    old_tag=${old_pre%.*}; old_num=$(_int "${old_pre##*.}")
    new_tag=${new_pre%.*}; new_num=$(_int "${new_pre##*.}")
    [ "$old_tag" = "$new_tag" ] && [ "$new_num" -gt "$old_num" ]
}

# Records which boot the staged marker was written in, so reconcile-staged can
# later tell "reboot still pending" (same boot id) from "the tryboot did not
# take" (a reboot happened and the staged version is still not the one
# running). Best-effort like the marker itself; an unreadable boot id leaves an
# empty record, which reconcile treats as "not this boot" once a real boot id
# is readable there.
record_staged_boot_id() {
    tr -d '[:space:]' <"$BOOT_ID_FILE" >"$STAGED_BOOT_FILE" 2>/dev/null || true
}

do_install() {
    command -v rauc >/dev/null 2>&1 || { log "rauc not installed"; return 1; }
    channel=$(resolve_channel)
    current=$(cat "$CUR_FILE" 2>/dev/null || echo "0.0.0")

    work=$(mktemp -d /tmp/segno-update.XXXXXX)
    # INT/TERM too: an EXIT trap alone never runs on an untrapped signal, and
    # a killed install would leave a whole staged bundle in /tmp.
    trap 'rm -rf "$work"' EXIT
    trap _on_terminate INT TERM
    progress 0

    if ! curl -fsSL --max-time 30 -o "$work/manifest.json" \
         "$BASE_URL/$channel/manifest.json"; then
        log "manifest fetch failed ($channel)"; return 1
    fi
    version=$(jq -r '.version // "0.0.0"' "$work/manifest.json" 2>/dev/null || echo "0.0.0")
    bundle=$(jq -r '.bundle // empty' "$work/manifest.json" 2>/dev/null || echo "")
    sha=$(jq -r '.sha256 // empty' "$work/manifest.json" 2>/dev/null || echo "")

    if [ -z "$bundle" ] || ! semver_newer "$current" "$version"; then
        log "nothing newer to install (published=$version current=$current)"
        return 1
    fi

    log "downloading v$version: $bundle"
    progress 5
    if ! curl -fsSL --max-time 1800 -o "$work/$bundle" \
         "$BASE_URL/$channel/$bundle"; then
        log "bundle download failed"; return 1
    fi
    progress 40

    # Defence in depth: manifest sha256 (RAUC also verifies the bundle's own
    # X.509 signature against the baked-in keyring — that is the real boundary).
    if [ -n "$sha" ]; then
        actual=$(sha256sum "$work/$bundle" | cut -d' ' -f1)
        if [ "$actual" != "$sha" ]; then
            log "sha256 mismatch (want $sha got $actual) — refusing"; return 1
        fi
    fi

    # Install to the inactive slot, mapping rauc's own "NN% ..." progress into
    # the 40..100 band. A fifo preserves rauc's exit code (a plain pipe loses it
    # under busybox sh, which has no reliable pipefail).
    log "installing v$version to the inactive slot"
    fifo="$work/rauc.fifo"
    mkfifo "$fifo"
    rauc install "$work/$bundle" >"$fifo" 2>&1 &
    rauc_pid=$!
    while IFS= read -r line; do
        pct=$(printf '%s' "$line" | sed -n 's/^ *\([0-9]\{1,3\}\)% .*/\1/p')
        [ -n "$pct" ] && progress $((40 + pct * 60 / 100))
        printf '%s\n' "$line" >&2
    done < "$fifo"
    if ! wait "$rauc_pid"; then
        log "rauc install failed"; return 1
    fi

    echo "$version" > "$STAGED_FILE" 2>/dev/null || true
    record_staged_boot_id
    : > "$PENDING_FLAG" 2>/dev/null || true
    progress 100
    log "staged v$version to the inactive slot; reboot to apply"
}

clear_staged_marker() { rm -f "$STAGED_FILE" "$STAGED_BOOT_FILE"; }

# Whether the staged tryboot "took" is recorded directly (the boot id written
# next to the marker at staging time) rather than inferred from RAUC's
# boot_status: the #307 health gate rolls a slot back BY DESIGN when it boots
# fine but never gets committed, and RAUC has no reason to call such a slot
# bad — so "inactive slot boot-bad" misses the expected rollback shape.
do_reconcile_staged() {
    if [ ! -f "$STAGED_FILE" ]; then
        # A boot-id record without its marker is residue (e.g. a marker
        # cleared by an image that predates the record) — sweep it.
        rm -f "$STAGED_BOOT_FILE"
        echo '{"cleared":false}'
        return 0
    fi
    staged=$(tr -d '[:space:]' <"$STAGED_FILE" 2>/dev/null || true)
    current=$(tr -d '[:space:]' <"$CUR_FILE" 2>/dev/null || echo "0.0.0")
    [ -n "$staged" ] || {
        clear_staged_marker
        echo '{"cleared":true,"reason":"empty"}'
        return 0
    }
    # Successfully running the staged build — drop the marker.
    if [ "$staged" = "$current" ]; then
        clear_staged_marker
        log "cleared staged=$staged (already running)"
        echo '{"cleared":true,"reason":"already-running"}'
        return 0
    fi
    # Not running the staged version. Same boot id as when it was staged means
    # the applying reboot simply has not happened yet — keep the marker. A
    # different one means a reboot DID happen and did not bring the staged
    # slot up: the tryboot did not take (boot-bad rollback or an uncommitted
    # health-gate rollback alike). A marker with no recorded boot id was
    # written by an image older than this one — i.e. before this boot — so the
    # same rule clears it with no special case.
    staged_boot=$(tr -d '[:space:]' <"$STAGED_BOOT_FILE" 2>/dev/null || true)
    booted=$(tr -d '[:space:]' <"$BOOT_ID_FILE" 2>/dev/null || true)
    if [ -n "$booted" ] && [ "$staged_boot" != "$booted" ]; then
        clear_staged_marker
        log "cleared staged=$staged (staged in a previous boot; tryboot did not take)"
        echo '{"cleared":true,"reason":"tryboot-not-taken"}'
        return 0
    fi
    echo '{"cleared":false}'
}

case "${1:-}" in
    install)          do_install ;;
    reconcile-staged) do_reconcile_staged ;;
    reboot)           log "rebooting into the staged slot"; exec systemctl reboot ;;
    poweroff)         log "powering off"; exec systemctl start poweroff.target ;;
    *)                log "usage: segno-update-ctl {install|reconcile-staged|reboot|poweroff}"; exit 2 ;;
esac
