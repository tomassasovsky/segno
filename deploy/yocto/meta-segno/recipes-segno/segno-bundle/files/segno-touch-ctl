#!/bin/sh
# segno-touch-ctl — privileged touchscreen calibration helper.
#
# Verbs (stdout = compact JSON; detail on stderr):
#   status          {"present":bool,"device":str,"calibrated":bool,"matrix":str}
#   get             {"calibrated":bool,"matrix":str}
#   set <6 floats>  {"calibrated":true,"matrix":str}   persist + apply now
#   reset           {"calibrated":false,"matrix":""}   forget the matrix
#
# The matrix is libinput's 6-element affine transform (the first two rows of a
# 3x3, row-major): "m1 m2 m3 m4 m5 m6" maps device coordinates onto the output.
# Identity is "1 0 0 0 1 0".
#
# It lives on /data, not in /etc, because a RAUC A/B update replaces the whole
# rootfs — a matrix written into /etc is silently lost on the next OTA. Same
# reason as segno-nm-persist / segno-bt-persist / segno-ssh-persist.
#
# Weston does the measuring: weston-touch-calibrator draws the crosshairs and
# computes the matrix, then calls the `calibration_helper` from weston.ini
# (segno-touch-calibration-helper), which lands here as `set`.
#
# See https://github.com/tomassasovsky/segno/issues/659
set -eu

DATA_DIR="${SEGNO_TOUCH_DIR:-/data/touch}"
MATRIX_FILE="$DATA_DIR/calibration"
RULE_FILE="${SEGNO_TOUCH_RULE:-/etc/udev/rules.d/98-segno-touch-calibration.rules}"

log() { echo "segno-touch-ctl: $*" >&2; }

# Writing the matrix is unprivileged (weston runs as User=weston and invokes the
# calibration helper as itself); turning it into a udev rule is not. `set` from
# an unprivileged caller therefore stores the matrix and lets
# segno-touch-apply.path notice the write and run `apply` as root.
is_root() { [ "$(id -u)" = "0" ]; }

# Name of the first touchscreen udev knows about, or empty.
#
# The name comes from sysfs, not from udevadm: udev sets NAME= for network
# interfaces, never for input event devices, so parsing `udevadm info` output for
# it silently yields nothing.
touch_device_name() {
    for ev in /dev/input/event*; do
        [ -e "$ev" ] || continue
        if udevadm info "$ev" 2>/dev/null | grep -q '^E: ID_INPUT_TOUCHSCREEN=1'; then
            cat "/sys/class/input/$(basename "$ev")/device/name" 2>/dev/null
            return 0
        fi
    done
    return 1
}

read_matrix() {
    [ -f "$MATRIX_FILE" ] || return 1
    m=$(head -n1 "$MATRIX_FILE" 2>/dev/null | tr -s ' \t' ' ' | sed 's/^ *//;s/ *$//')
    [ -n "$m" ] || return 1
    echo "$m"
}

# Reject anything that is not exactly six numbers — a malformed rule makes udev
# drop the whole file, which would take the touchscreen out with it.
validate_matrix() {
    n=0
    for v in $1; do
        case "$v" in
            ''|*[!0-9.eE+-]*) log "not a number: '$v'"; return 1 ;;
        esac
        n=$((n + 1))
    done
    [ "$n" -eq 6 ] || { log "need 6 values, got $n"; return 1; }
}

# Regenerate the udev rule from the stored matrix and re-trigger input devices
# so it applies without a reboot. Root only — see is_root().
apply() {
    if ! is_root; then
        log "not root: leaving the udev rule to segno-touch-apply.path"
        return 0
    fi
    if ! m=$(read_matrix); then
        rm -f "$RULE_FILE"
    else
        mkdir -p "$(dirname "$RULE_FILE")"
        cat > "$RULE_FILE" <<EOF
# Generated by segno-touch-ctl — do not edit by hand.
# Source of truth is $MATRIX_FILE on the persistent /data partition.
ACTION=="add|change", SUBSYSTEM=="input", ENV{ID_INPUT_TOUCHSCREEN}=="1", \\
  ENV{LIBINPUT_CALIBRATION_MATRIX}="$m"
EOF
    fi
    # --reload-rules is asynchronous. Triggering straight after it re-runs the
    # OLD rule set, so the freshly-written matrix is silently not applied and
    # `set` reports success on a calibration that never took. Drain the queue to
    # let the reload land, trigger, then wait for those events to be processed.
    udevadm control --reload-rules 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true
    udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true
}

json_matrix() {
    if m=$(read_matrix); then
        printf '{"calibrated":true,"matrix":"%s"}\n' "$m"
    else
        printf '{"calibrated":false,"matrix":""}\n'
    fi
}

do_status() {
    if dev=$(touch_device_name); then present=true; else present=false; dev=""; fi
    if m=$(read_matrix); then cal=true; else cal=false; m=""; fi
    printf '{"present":%s,"device":"%s","calibrated":%s,"matrix":"%s"}\n' \
        "$present" "$dev" "$cal" "$m"
}

do_set() {
    m=$(echo "$*" | tr -s ' \t' ' ' | sed 's/^ *//;s/ *$//')
    validate_matrix "$m" || return 2
    # mkdir only works as root; when weston calls this the directory already
    # exists and is owned by the compositor user (segno-touch-persist, which is
    # ordered Before=weston.service, creates it).
    if is_root; then
        mkdir -p "$DATA_DIR"
    elif [ ! -d "$DATA_DIR" ]; then
        log "$DATA_DIR missing and not root — is segno-touch-persist enabled?"
        return 1
    fi
    echo "$m" > "$MATRIX_FILE"
    apply
    json_matrix
}

do_reset() {
    rm -f "$MATRIX_FILE"
    apply
    json_matrix
}

usage() {
    log "usage: $0 status|get|set <m1 m2 m3 m4 m5 m6>|reset|apply"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    status) do_status ;;
    get) json_matrix ;;
    set)
        [ $# -ge 1 ] || usage
        do_set "$@"
        ;;
    reset) do_reset ;;
    # Used by segno-touch-persist at boot: re-derive the rule from /data.
    apply) apply; json_matrix ;;
    *) usage ;;
esac
