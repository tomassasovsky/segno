#!/bin/sh
# segno-touch-ctl — per-screen touchscreen calibration (run as root by the app).
#
# The console has a touchscreen on each screen:
#   readout  the 7": the touchscreen whose name contains the `touch_device` of
#            the readout's view in /etc/segno/homescreen.toml, the same match
#            ivi-homescreen uses to route its touches to that view
#   main     every other touchscreen
#
# Verbs (stdout = compact JSON; detail on stderr):
#   get <screen>              {"calibrated":bool,"matrix":str}
#   try <screen> <6 floats>   apply to that screen's touchscreen now, without
#                             persisting: a reboot, or `restore`, drops it
#   set <screen> <6 floats>   persist, and apply to that screen's touchscreen now
#   reset <screen>            forget the matrix, and apply now
#   restore <screen>          apply what is persisted again, dropping a `try`
#   apply                     rebuild the udev rule from /data (boot, before the
#                             app opens its input devices)
#
# The app tries a new calibration with `try` and persists it with `set` only
# when the player keeps it, so a calibration that made a screen untouchable is
# gone after a power cycle.
#
# The matrix is libinput's 6-element affine transform (the first two rows of a
# 3x3, row-major): "m1 m2 m3 m4 m5 m6" maps device coordinates onto the output.
# Identity is "1 0 0 0 1 0".
#
# It lives on /data, not in /etc, because a RAUC A/B update replaces the whole
# rootfs — a matrix written into /etc is silently lost on the next OTA. Same
# reason as segno-nm-persist / segno-ssh-persist.
#
# The app does the measuring (Settings > Displays > Calibrate touch, #1330).
#
# See https://github.com/tomassasovsky/segno/issues/659
set -eu

DATA_DIR="${SEGNO_TOUCH_DIR:-/data/touch}"
RULE_FILE="${SEGNO_TOUCH_RULE:-/etc/udev/rules.d/98-segno-touch-calibration.rules}"
CONFIG="${SEGNO_HOMESCREEN_CONFIG:-/etc/segno/homescreen.toml}"
INPUT_ROOT="${SEGNO_INPUT_ROOT:-/sys/class/input}"

log() { echo "segno-touch-ctl: $*" >&2; }

matrix_file() { echo "$DATA_DIR/$1"; }

valid_screen() {
    case "$1" in
        main | readout) return 0 ;;
        *) log "unknown screen: '$1' (main or readout)"; return 1 ;;
    esac
}

# The readout's touch_device: a substring of its touchscreen's name. The
# readout is the only view that names one; touch that matches no view goes to
# the main screen, and so does the main screen's calibration. A name udev would
# read as a pattern is refused, since udev and this script would then disagree
# on which touchscreen it names.
readout_name() {
    n=$(sed -n "s/^[[:space:]]*touch_device[[:space:]]*=[[:space:]]*['\"]\([^'\"]*\)['\"].*/\1/p" \
        "$CONFIG" 2>/dev/null | head -n1)
    case "$n" in
        *[][*?\|]*) log "touch_device '$n' has a udev pattern character: ignored" ;;
        *) echo "$n" ;;
    esac
}

# The readout's calibration cannot be applied without its touchscreen's name.
routable() {
    [ "$1" != readout ] || [ -n "$(readout_name)" ] || {
        log "no usable touch_device in $CONFIG: the readout cannot be calibrated"
        return 1
    }
}

read_matrix() {
    f=$(matrix_file "$1")
    [ -f "$f" ] || return 1
    m=$(head -n1 "$f" 2>/dev/null | tr -s ' \t' ' ' | sed 's/^ *//;s/ *$//')
    [ -n "$m" ] || return 1
    echo "$m"
}

# Reject anything that is not exactly six numbers — a malformed rule makes udev
# drop the whole file, which would take the touchscreen out with it.
#
# A character-class test is not enough: `.`, `1.2.3`, `+-` and `e` are all
# built from permitted characters and would sail through to the rule this
# check exists to protect. Each value has to parse as a real decimal, so the
# grammar is spelled out.
is_number() {
    echo "$1" | awk '{ exit ($0 ~ /^[+-]?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?$/) ? 0 : 1 }'
}

validate_matrix() {
    n=0
    for v in $1; do
        is_number "$v" || { log "not a number: '$v'"; return 1; }
        n=$((n + 1))
    done
    [ "$n" -eq 6 ] || { log "need 6 values, got $n"; return 1; }
}

# Regenerate the udev rule from the stored matrices, or with [matrix] in place
# of [screen]'s for a `try`: one line per screen, matched by the touchscreen's
# name. The main screen's line matches every touchscreen and comes first; the
# readout's comes after and wins for its touchscreen (a later assignment
# replaces an earlier one), with the identity when only the main screen is
# calibrated, so the 7" never takes the main screen's matrix.
write_rule() {
    name=$(readout_name)
    main=$(read_matrix main) || main=""
    readout=$(read_matrix readout) || readout=""
    case "${1:-}" in
        main) main=$2 ;;
        readout) readout=$2 ;;
    esac
    [ -z "$name" ] || [ -n "$readout" ] || [ -z "$main" ] || readout="1 0 0 0 1 0"
    rules=""
    if [ -n "$main" ]; then
        rules="${rules}ACTION==\"add|change\", SUBSYSTEM==\"input\", ENV{ID_INPUT_TOUCHSCREEN}==\"1\", ENV{LIBINPUT_CALIBRATION_MATRIX}=\"$main\"
"
    fi
    if [ -n "$readout" ] && [ -n "$name" ]; then
        rules="${rules}ACTION==\"add|change\", SUBSYSTEM==\"input\", ENV{ID_INPUT_TOUCHSCREEN}==\"1\", ATTRS{name}==\"*${name}*\", ENV{LIBINPUT_CALIBRATION_MATRIX}=\"$readout\"
"
    fi
    if [ -z "$rules" ]; then
        rm -f "$RULE_FILE"
        return 0
    fi
    mkdir -p "$(dirname "$RULE_FILE")"
    {
        echo "# Generated by segno-touch-ctl — do not edit by hand."
        echo "# Source of truth: $DATA_DIR/{main,readout} on the persistent /data partition."
        printf '%s' "$rules"
    } > "$RULE_FILE"
}

# --reload-rules is asynchronous: triggering straight after it re-runs the OLD
# rule set. Drain the queue to let the reload land before anything triggers.
reload_rules() {
    udevadm control --reload-rules 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true
}

# Each touchscreen's sysfs path and the screen it belongs to, one per line.
touchscreens() {
    name=$(readout_name)
    for ev in "$INPUT_ROOT"/event*; do
        [ -e "$ev" ] || continue
        udevadm info --query=property --path="$ev" 2>/dev/null |
            grep -q '^ID_INPUT_TOUCHSCREEN=1$' || continue
        dev_name=$(cat "$ev/device/name" 2>/dev/null || true)
        screen=main
        case "$dev_name" in
            *"$name"*) [ -z "$name" ] || screen=readout ;;
        esac
        echo "$screen $ev"
    done
}

# libinput reads the calibration matrix when a device is added, and ignores a
# udev `change`, so a matrix set while the app runs only takes effect if the
# device is removed and added again; the app's libinput (udev backend) follows
# both. Only the touchscreen of [screen] is cycled.
readd() {
    touchscreens | while read -r screen ev; do
        [ "$screen" = "$1" ] || continue
        udevadm trigger --action=remove "$ev" 2>/dev/null || true
        udevadm settle --timeout=5 2>/dev/null || true
        udevadm trigger --action=add "$ev" 2>/dev/null || true
        udevadm settle --timeout=5 2>/dev/null || true
    done
}

json_matrix() {
    if m=$(read_matrix "$1"); then
        printf '{"calibrated":true,"matrix":"%s"}\n' "$m"
    else
        printf '{"calibrated":false,"matrix":""}\n'
    fi
}

normalize() { echo "$*" | tr -s ' \t' ' ' | sed 's/^ *//;s/ *$//'; }

do_try() {
    screen=$1
    shift
    m=$(normalize "$@")
    validate_matrix "$m" || return 2
    routable "$screen" || return 3
    write_rule "$screen" "$m"
    reload_rules
    readd "$screen"
    printf '{"calibrated":true,"matrix":"%s"}\n' "$m"
}

do_restore() {
    write_rule
    reload_rules
    readd "$1"
    json_matrix "$1"
}

do_set() {
    screen=$1
    shift
    m=$(normalize "$@")
    validate_matrix "$m" || return 2
    routable "$screen" || return 3
    mkdir -p "$DATA_DIR"
    echo "$m" > "$(matrix_file "$screen")"
    write_rule
    reload_rules
    readd "$screen"
    json_matrix "$screen"
}

do_reset() {
    rm -f "$(matrix_file "$1")"
    write_rule
    reload_rules
    readd "$1"
    json_matrix "$1"
}

# At boot nothing has the devices open yet: refresh their udev properties with
# a `change`, and the app's libinput reads the matrix when it adds them.
do_apply() {
    write_rule
    reload_rules
    udevadm trigger --subsystem-match=input --action=change 2>/dev/null || true
    udevadm settle --timeout=5 2>/dev/null || true
}

usage() {
    log "usage: $0 get <screen>|try <screen> <m1 m2 m3 m4 m5 m6>|set <screen> <m1 m2 m3 m4 m5 m6>|reset <screen>|restore <screen>|apply  (screen: main, readout)"
    exit 2
}

[ $# -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    get)
        [ $# -eq 1 ] || usage
        valid_screen "$1" || exit 2
        json_matrix "$1"
        ;;
    try)
        [ $# -ge 2 ] || usage
        valid_screen "$1" || exit 2
        do_try "$@"
        ;;
    set)
        [ $# -ge 2 ] || usage
        valid_screen "$1" || exit 2
        do_set "$@"
        ;;
    restore)
        [ $# -eq 1 ] || usage
        valid_screen "$1" || exit 2
        do_restore "$1"
        ;;
    reset)
        [ $# -eq 1 ] || usage
        valid_screen "$1" || exit 2
        do_reset "$1"
        ;;
    apply) do_apply ;;
    *) usage ;;
esac
