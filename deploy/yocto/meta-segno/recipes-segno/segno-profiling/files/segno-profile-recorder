#!/bin/sh
# Records how the Segno app behaves over hours and days, so slow growth shows
# up as a trend instead of as "it got sluggish at some point" (#1299).
#
# Every minute, one CSV row in /data/perf/metrics-<date>.csv:
#   time            ISO 8601, UTC
#   pid             the app; a new pid means it restarted
#   app_uptime_s    seconds since that pid started
#   rss_kb          resident memory
#   threads, fds    counts
#   cpu_pct         whole process, % of one core over the last interval
#   main_pct        ivi-homescreen's main thread, mostly idle
#   ui_pct          the io.flutter.ui threads, summed: the Dart UI isolates,
#                   one per screen
#   raster_pct      the io.flutter.raster threads, summed
#   rt_pct          SCHED_FIFO and SCHED_RR threads, summed (the audio engine)
#   ui_preempt_s    involuntary context switches per second on the
#                   io.flutter.ui threads: high means they are runnable and
#                   waiting for a core
#   load1, mem_available_kb  system-wide
#
# The audio thread inherits the io.flutter.ui name, so ui_pct and ui_preempt_s
# skip SCHED_FIFO and SCHED_RR threads; rt_pct counts it. The engine's other
# native threads (render, cache, restore) inherit the name too and run
# SCHED_OTHER, so they count in ui_pct until the engine names them.
#
# Every 15 minutes, a folded-stack profile of the main screen's Dart UI
# isolate (stacks-<time>.folded, segno-prof stack, 1000 samples 10 ms apart):
# the io.flutter.ui thread that is not real-time with the lowest tid, the
# oldest, which is the first engine's, the main screen's (#1318). Lowest by
# number: the threads are listed in text order, where 1003 comes before 987.
#
# Files older than 30 days are deleted. Experimental images only: the unit
# checks the channel before starting this. Not /data/profile: that is where
# deploy/rpi/profile-on-device.sh unpacks (and first wipes) a profile build.
set -u

dir=/data/perf
interval=60
stack_every=15        # in intervals
keep_days=30
hz=100                # USER_HZ on this kernel; the image has no getconf

mkdir -p "$dir"
state=$(mktemp -d)
trap 'rm -rf "$state"' EXIT

# One line per thread: tid comm cpu_ticks policy nonvoluntary_switches
snapshot_threads() {
  for task in /proc/"$1"/task/*; do
    stat=$(cat "$task/stat" 2>/dev/null) || continue
    comm=$(tr ' ' '_' < "$task/comm" 2>/dev/null) || continue
    nvcsw=$(awk '/^nonvoluntary_ctxt_switches/ {print $2}' "$task/status" 2>/dev/null)
    # Fields after "pid (comm) ": state is 1, utime 12, stime 13, policy 39.
    set -- ${stat##*) }
    echo "${task##*/} $comm $(( ${12} + ${13} )) ${39} ${nvcsw:-0}"
  done
}

tick=0
stack_due=0
deferred_pid=""
pid_before=""
uptime_before=""
while :; do
  pid=$(pidof segno | awk '{print $1}')
  if [ -z "$pid" ]; then
    sleep "$interval"
    continue
  fi
  if [ "$pid" != "$pid_before" ]; then
    : > "$state/threads"
    uptime_before=""
    pid_before=$pid
  fi

  snapshot_threads "$pid" > "$state/threads.now"
  read -r uptime _ < /proc/uptime
  # Rates divide by the time that really passed: a pass that also samples
  # stacks takes several seconds longer than the interval.
  elapsed=$(awk -v now="$uptime" -v then="${uptime_before:-0}" 'BEGIN {printf "%.2f", now - then}')
  uptime_before=$uptime
  started=$(set -- $(sed 's/.*) //' /proc/"$pid"/stat); echo "${20}")
  app_uptime=$(awk -v u="$uptime" -v s="$started" -v hz="$hz" 'BEGIN {printf "%d", u - s / hz}')
  rss=$(awk '/^VmRSS/ {print $2}' /proc/"$pid"/status)
  threads=$(awk '/^Threads/ {print $2}' /proc/"$pid"/status)
  fds=$(ls /proc/"$pid"/fd | wc -l)
  load1=$(cut -d' ' -f1 /proc/loadavg)
  available=$(awk '/^MemAvailable/ {print $2}' /proc/meminfo)

  # Per-thread CPU over the interval, counting only threads present in both
  # snapshots: a new thread's cumulative time would land in one row as a
  # spike, so short-lived threads under-report instead. The first row after a
  # restart is blank.
  cpu=$(awk -v pid="$pid" -v secs="$elapsed" -v hz="$hz" '
    FILENAME == ARGV[1] { ticks[$1] = $3; nv[$1] = $5; seen = 1; next }
    {
      if (!seen || !($1 in ticks)) next
      d = $3 - ticks[$1]
      total += d
      if ($1 == pid) main = d
      if ($2 == "io.flutter.ui" && $4 != 1 && $4 != 2) {
        ui += d
        preempt += $5 - nv[$1]
      }
      if ($2 ~ /^io\.flutter\.rast/) raster += d
      if ($4 == 1 || $4 == 2) rt += d
    }
    END {
      if (!seen) { print ",,,,,"; exit }
      f = 100 / (secs * hz)
      printf "%.1f,%.1f,%.1f,%.1f,%.1f,%.0f", total * f, main * f, ui * f, raster * f, rt * f, preempt / secs
    }' "$state/threads" "$state/threads.now")
  mv "$state/threads.now" "$state/threads"

  file="$dir/metrics-$(date -u +%Y%m%d).csv"
  header="time,pid,app_uptime_s,rss_kb,threads,fds,cpu_pct,main_pct,ui_pct,raster_pct,rt_pct,ui_preempt_s,load1,mem_available_kb"
  # A day file an earlier build started has other columns: set it aside
  # rather than append rows that do not match its header.
  if [ -s "$file" ] && [ "$(head -n1 "$file")" != "$header" ]; then
    mv "$file" "${file%.csv}-earlier-build-$(date -u +%H%M%S).csv"
  fi
  [ -s "$file" ] || echo "$header" > "$file"
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ),$pid,$app_uptime,$rss,$threads,$fds,$cpu,$load1,$available" >> "$file"

  [ $(( tick % stack_every )) -eq 0 ] && stack_due=1
  if [ "$stack_due" = 1 ]; then
    ui=$(awk '$2 == "io.flutter.ui" && $4 != 1 && $4 != 2 &&
      (first == "" || $1 + 0 < first + 0) { first = $1 }
      END { if (first != "") print first }' "$state/threads")
    # Right after the app starts its UI thread may not exist yet (at boot this
    # loop's first pass runs before either engine is up). Keep the profile
    # due and try again next interval rather than sample the wrong thread.
    if [ -n "$ui" ]; then
      segno-prof stack "$pid" "$ui" 1000 10 \
        > "$dir/stacks-$(date -u +%Y%m%dT%H%M%SZ).folded" 2>/dev/null
      find "$dir" -type f -mtime +"$keep_days" -exec rm -f {} +
      stack_due=0
      deferred_pid=""
    elif [ "$deferred_pid" != "$pid" ]; then
      # Once per pid, so a missing thread (a renamed UI thread, a crash loop)
      # shows in the journal instead of as profiles that silently stop.
      echo "no io.flutter.ui thread in $pid yet; profile deferred" >&2
      deferred_pid=$pid
    fi
  fi
  tick=$(( tick + 1 ))
  sleep "$interval"
done
