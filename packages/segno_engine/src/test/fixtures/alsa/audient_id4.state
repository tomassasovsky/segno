# Audient iD4 (USB 2708:0003): alsactl state attached to
# https://github.com/alsa-project/alsa-ucm-conf/issues/170 (files/8910772/alsactl.txt).
# usb 2708:0003
state.iD4 {
	control.1 {
		iface PCM
		name 'Playback Channel Map'
		value.0 3
		value.1 4
		comment {
			access read
			type INTEGER
			count 2
			range '0 - 36'
		}
	}
	control.2 {
		iface PCM
		name 'Capture Channel Map'
		value.0 3
		value.1 4
		comment {
			access read
			type INTEGER
			count 2
			range '0 - 36'
		}
	}
	control.3 {
		iface CARD
		name 'Audient Internal Clock Validity'
		value true
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
}
