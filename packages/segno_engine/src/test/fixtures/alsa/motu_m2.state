# MOTU M2: the alsactl section (block state.M2) of the alsa-info.sh v0.5.1 upload attached to
# https://github.com/alsa-project/alsa-ucm-conf/issues/190 (files/9128478/alsa-info.txt, 2022-07-17); components 'USB07fd:000b'.
# usb 07fd:000b
state.M2 {
	control.1 {
		iface PCM
		name 'Playback Channel Map'
		value.0 3
		value.1 4
		comment {
			access read
			type INTEGER
			count 2
			range '0 - 36'
		}
	}
	control.2 {
		iface PCM
		name 'Capture Channel Map'
		value.0 0
		value.1 0
		comment {
			access read
			type INTEGER
			count 2
			range '0 - 36'
		}
	}
	control.3 {
		iface CARD
		name 'Internal Validity'
		value true
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
}
