# MOTU M4: the alsactl section (block state.M4) of the alsa-info.sh v0.5.1 upload attached to
# https://github.com/alsa-project/alsa-ucm-conf/issues/212 (files/9528667, 2022-09-08); components 'USB07fd:0008'.
# usb 07fd:0008
state.M4 {
	control.1 {
		iface PCM
		name 'Playback Channel Map'
		value.0 3
		value.1 4
		value.2 7
		value.3 8
		comment {
			access read
			type INTEGER
			count 4
			range '0 - 36'
		}
	}
	control.2 {
		iface PCM
		name 'Capture Channel Map'
		value.0 0
		value.1 0
		value.2 0
		value.3 0
		comment {
			access read
			type INTEGER
			count 4
			range '0 - 36'
		}
	}
	control.3 {
		iface CARD
		name 'MOTU Internal Clock Validity'
		value true
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
}
