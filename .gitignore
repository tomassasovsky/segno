# --- local tooling / scratch (not part of the repo) ---
# Ignore .claude/ contents (settings.local.json etc.) but TRACK the shared
# launch config so the 3D viewer is one command for anyone who clones, the
# shared settings (tracking-reminder + iterative-dev hooks) so every
# session/agent respects them, the hook scripts those settings run, and the
# shared project skills.
.claude/*
!.claude/launch.json
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.portfolio-output/

__pycache__/
*.lck

# graphify knowledge-graph output (generated; rebuild with `graphify update .`)
graphify-out/

# Tier 3a: staged prebuilt bundle for the Yocto build (binary artifact)
deploy/yocto/prebuilt/
deploy/yocto/meta-segno/.rauc-keys/
docs/code-review/


# Widget Preview related
.widget_preview/
ios/Flutter/ephemeral/.swift_pm.lock

# Moved to sibling repositories (#1496): the design file and studies to
# tomassasovsky/segno-design (cloned at ../segno-design), the hardware to
# tomassasovsky/segno-hardware. The main checkout keeps untracked design
# studies, the pen's font cache (fonts/) and hardware tooling (.venv) at these
# paths; this keeps them out of the index.
/segno-ui.pen
/docs/design/
/fonts/
/hardware/

# Rendered by the screenshot tests (flutter test --tags screenshots
# --update-goldens); CI uploads them as the screenshots artifact.
/test/screenshots/goldens/
