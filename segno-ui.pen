      "x": 10220,
      "y": 8713,
      "name": "g/audio-recording",
      "fill": "#738cf2",
      "content": "base",
      "fontFamily": "Inter",
      "fontSize": 12,
      "fontWeight": "600"
    },
    {
      "type": "text",
      "id": "DQsf1",
      "x": 10220,
      "y": 8736,
      "name": "c/audio-recording",
      "fill": "#9ea3b0",
      "textGrowth": "fixed-width",
      "width": 1800,
      "content": "Max loop length, quantize, overdub on second press, sound-activated, default length. The base state has every row SHUT.",
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": "normal"
    },
    {
      "type": "text",
      "id": "SIJXM",
