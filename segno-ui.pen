    {
      "type": "text",
      "id": "CMJ8R",
      "x": 20396,
      "y": 13236,
      "name": "c/licences",
      "fill": "#9ea3b0",
      "textGrowth": "fixed-width",
      "width": 1800,
      "content": "Flutter's showLicensePage is a master-detail route: an app bar, a back chevron, list tiles, a second page per package. The rail is always on screen, so a back chevron is a second navigation surface, and a row that pushes a page loses the list it came from. So the notices are drawn like every other list here — rows that open IN PLACE, one at a time, in the panel the per-track routing dialog already uses. A long document is still a list. Both LEGAL rows on SYSTEM / about reach it: there is one page, and they are two ways of asking for it.",
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": "normal"
    },
