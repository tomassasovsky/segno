                  "children": [
                    {
                      "type": "text",
                      "id": "nADTt",
                      "name": "T",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "20 per row, then wrap",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-md",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "UMgtk",
                      "name": "B",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "78px tile on a 7px gutter fills a 1738px panel at 20 columns. The grid wraps and scrolls vertically; it never scrolls horizontally, so no parameter can hide off the right edge.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-xs",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "bF0Rl",
                  "name": "Names truncate, the sheet does not",
                  "width": "fill_container",
                  "fill": "$bg-elevated",
                  "cornerRadius": "$radius-10",
                  "stroke": "$border-default",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": "$space-4",
                  "padding": "$space-8",
                  "children": [
                    {
                      "type": "text",
                      "id": "M0Qgxx",
                      "name": "T",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Names truncate, the sheet does not",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-md",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "qYm63",
                      "name": "B",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A tile name is mono 9px in 78px — about 10 characters. Longer names ellipsize on the tile and appear in full in the sheet header, which is where you are when you actually need to read it.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-xs",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "mDcG7",
                  "name": "Plugin text wins in the sheet, numbers win on the tile",
                  "width": "fill_container",
                  "fill": "$bg-elevated",
                  "cornerRadius": "$radius-10",
                  "stroke": "$border-default",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": "$space-4",
                  "padding": "$space-8",
                  "children": [
                    {
                      "type": "text",
                      "id": "WTo6u",
                      "name": "T",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "One string, straight from the plugin",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-md",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "w5p4Fz",
                      "name": "B",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The value and its unit live together in the box, because paramValueText hands them over as a single string — \"-6.0 dB\", \"Lowpass\", \"1/4 dotted\". Splitting them would mean parsing the plugin's own formatting apart. When a plugin offers no text, the tile falls back to the numeric value plus the separate unit field; when it does, the unit slot simply goes unused, as on KNEE = \"soft\".",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-xs",
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "RrJ5Q",
                  "name": "The grid is never the live surface",
                  "width": "fill_container",
                  "fill": "$bg-elevated",
                  "cornerRadius": "$radius-10",
                  "stroke": "$border-default",
                  "strokeWidth": 1,
                  "strokeAlignment": "inner",
                  "layout": "vertical",
                  "gap": "$space-4",
                  "padding": "$space-8",
                  "children": [
                    {
                      "type": "text",
                      "id": "AL6ec",
                      "name": "T",
                      "fill": "$text-primary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The grid is never the live surface",
                      "lineHeight": 1.25,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-md",
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "VDpTk",
                      "name": "B",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Tiles commit nothing on touch — they open the sheet. Mid-take control belongs to the foot pedal, so no drag on this screen can change audio by accident.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-ui",
                      "fontSize": "$text-xs",
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
