      "fill": "#ffffff",
      "content": "Audio — max loop length",
      "fontFamily": "Inter",
      "fontSize": 15,
      "fontWeight": "600"
    },
    {
      "type": "text",
      "id": "ZwJzJ",
      "x": 12264,
      "y": 8713,
      "name": "g/settings-maxloop",
      "fill": "#738cf2",
      "content": "open",
      "fontFamily": "Inter",
      "fontSize": 12,
      "fontWeight": "600"
    },
    {
      "type": "text",
      "id": "H9LZmB",
      "x": 12264,
      "y": 8736,
      "name": "c/settings-maxloop",
      "fill": "#9ea3b0",
      "textGrowth": "fixed-width",
      "width": 1800,
      "content": "A higher cap reserves more memory per track. A chip grid for the same reason the rate is one — every option is a bare token.",
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": "normal"
    },
    {
      "type": "text",
