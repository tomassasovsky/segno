    {
      "type": "text",
      "id": "ttH4R",
      "x": 28484,
      "y": 8736,
      "name": "c/settings-inputs-wide",
      "fill": "#9ea3b0",
      "textGrowth": "fixed-width",
      "width": 1800,
      "content": "Eighteen sockets are TWO ROWS of chips, 106px, and this is why the list is a grid at all: as 70px rows the same list is 1,260px, five times the height of the card it opens inside. The grid fits as many ~166px cells as the measure allows and shares out the remainder, so the run stays flush to both edges whatever the rig has. Naming is NOT capped at the engine's lane ceiling — that constant caps how many lanes ONE TRACK may have, not which input a lane records, so socket 12 is routable and worth naming (#528).",
      "fontFamily": "Inter",
      "fontSize": 13,
      "fontWeight": "normal"
    },
