(footprint "Relay_Omron_G6C-1117P-US"
(version 20240108) (generator pcbnew) (layer "F.Cu")
(descr "Omron G6C-1117P-US, SPST-NO (1 Form A) PCB power relay, straight flux-protected terminals. Bottom-view drawing on datasheet page 7 converted to this top view: pin 1 coil negative at the origin, pin 8 coil positive 10.16mm below it, and the normally open contact pins 3 and 4 at 10.16mm and 17.78mm to the left. Body 20 x 15 x 10mm maximum with 0.3mm standoff; Omron recommends four 1.1mm holes. https://omronfs.omron.com/en_US/ecb/products/pdf/en-g6c.pdf")
(tags "relay SPST-NO 1FormA power through-hole Omron G6C") (attr through_hole)
(property "Reference" "K**" (at -8.89 -4.2) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
(property "Value" "G6C-1117P-US" (at -8.89 14.3) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
(fp_rect (start -18.89 -2.44) (end 1.11 12.56) (stroke (width 0.1) (type default)) (fill none) (layer "F.Fab"))
(fp_text user "${REFERENCE}" (at -8.89 5.08) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
(fp_line (start -19.04 -2.59) (end 1.26 -2.59) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -19.04 12.71) (end 1.26 12.71) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -19.04 -2.59) (end -19.04 -0.9) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -19.04 0.9) (end -19.04 12.71) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start 1.26 -2.59) (end 1.26 -0.9) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start 1.26 0.9) (end 1.26 9.26) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start 1.26 11.06) (end 1.26 12.71) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -4.7 0) (end -3.3 0) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -4.7 10.16) (end -3.3 10.16) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_line (start -4 9.46) (end -4 10.86) (stroke (width 0.15) (type default)) (layer "F.SilkS"))
(fp_rect (start -19.14 -2.69) (end 1.36 12.81) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
(pad "1" thru_hole circle (at 0 0) (size 2.4 2.4) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "8" thru_hole circle (at 0 10.16) (size 2.4 2.4) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "3" thru_hole circle (at -10.16 0) (size 2.4 2.4) (drill 1.2) (layers "*.Cu" "*.Mask"))
(pad "4" thru_hole circle (at -17.78 0) (size 2.4 2.4) (drill 1.2) (layers "*.Cu" "*.Mask"))
(model "${KIPRJMOD}/../models/Relay_Omron_G6C-1117P-US.step"
  (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
