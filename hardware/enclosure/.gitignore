# CAD toolchain venv (recreate: python3.12 -m venv .venv && .venv/bin/pip install ezdxf cadquery matplotlib)
.venv/
__pycache__/

# scratch scripts (underscore-prefixed, per repo convention)
_*.py

# out/ policy (#236): the canonical per-part manufacturing outputs written by
# segno_enclosure.py — DXF + PDF + STEP/STL, plus the reference files
# rear_io_stations.json and segno_encoder_knob.step/.stl — are TRACKED: they
# are the reviewable, diffable fab truth. Everything else regenerates on
# demand and stays untracked: scratch renders (out/_*), preview renders and
# SVGs, 3D viewer bundles, and the per-quote vendor zips (rebuilt with a
# freshness gate by build_quote_packages()). The exact zips sent on a real
# vendor order are frozen as git tag / GitHub Release assets — see
# hardware/MANUFACTURING.md.

# scratch render artifacts (underscore-prefixed, per repo convention)
out/_*

# preview renders (segno_render*.png etc.) and layout SVGs
out/*.png
out/*.svg

# 3D viewer bundles (out/index.html + out/viewer.html + glTF payloads)
out/*.glb
out/*.gltf
out/*.bin
out/index.html
out/viewer.html

# per-quote vendor bundles + per-quote scratch — regenerate before quoting
out/*.zip
out/quote_pkg/
